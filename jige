LEGACY_DISCOVERIES_FILE = Path.home() / "Library" / "Caches" / "jige" / "legacy_discoveries.json"


def load_legacy_commit_map(token: str) -> dict[str, dict]:
    """recipes/legacy/<token>.json: {"<macOS 메이저 번호>": {"commit_url":..., "found_by":...,
    "confirmations": [...]}} 형태. 1) 로컬에 있으면 그걸(jige 자체 개발 중일 때),
    2) 없으면 GitHub의 recipes/legacy/<token>.json을 load_homebrew_index()와 똑같은
    24시간 캐시로 받아옴 — PR이 머지되면 jige 코드 업데이트 없이도 하루 안에 퍼짐."""
    local_path = LOCAL_LEGACY_DIR / f"{token}.json"
    if local_path.exists():
        try:
            return json.loads(local_path.read_text())
        except json.JSONDecodeError:
            return {}

    cache_dir = INDEX_CACHE_DIR / "legacy"
    cache_path = cache_dir / f"{token}.json"
    if not cache_path.exists() or (time.time() - cache_path.stat().st_mtime) > INDEX_MAX_AGE_SECONDS:
        cache_dir.mkdir(parents=True, exist_ok=True)
        url = f"{JIGE_LEGACY_RAW_BASE}/{urllib.parse.quote(token, safe='')}.json"
        try:
            _download_json(url, cache_path)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                cache_path.write_text("{}")  # 이 토큰엔 큐레이션 없음 — 매번 재조회 안 하게 캐시
            elif not cache_path.exists():
                return {}
        except Exception:
            if not cache_path.exists():
                return {}

    try:
        return json.loads(cache_path.read_text())
    except json.JSONDecodeError:
        return {}


def load_discoveries() -> dict:
    if not LEGACY_DISCOVERIES_FILE.exists():
        return {}
    try:
        return json.loads(LEGACY_DISCOVERIES_FILE.read_text())
    except json.JSONDecodeError:
        return {}


def save_discovery(token: str, major: str, entry: dict) -> None:
    """이 기기가 직접 찾아낸 (아직 저장소엔 없는) 대체판을 로컬에 캐시 — 같은 토큰을
    다시 설치할 때 매번 git 기록을 다시 안 뒤지게. 저장소(recipes/legacy/) 반영은
    사람이 이 파일을 보고 따로 검토해서 커밋함(자동 커밋 안 함)."""
    data = load_discoveries()
    data[f"{token}/{major}"] = entry
    LEGACY_DISCOVERIES_FILE.parent.mkdir(parents=True, exist_ok=True)
    LEGACY_DISCOVERIES_FILE.write_text(json.dumps(data, ensure_ascii=False, indent=2))


def pick_legacy_for_this_mac(token: str) -> dict | None:
    """비용이 싼 조회만 함(로컬 discoveries 캐시 -> recipes/legacy/ 저장된 값) —
    git 기록을 뒤지는 live 검색(find_legacy_commit_live)은 여기서 안 함. search처럼
    여러 토큰을 한 번에 훑는 곳에서 매번 git 검색이 돌면 너무 느려지기 때문."""
    if current_os() != "macos":
        return None
    major = str(macos_version_tuple()[0])
    discovered = load_discoveries().get(f"{token}/{major}")
    if discovered:
        return discovered
    return load_legacy_commit_map(token).get(major)


def cask_rb_path(token: str) -> str:
    return f"Casks/{token[0].lower()}/{token}.rb"


HOMEBREW_CASK_REPO = "Homebrew/homebrew-cask"


def list_cask_commits(path: str, max_commits: int = 150) -> list[dict]:
    commits: list[dict] = []
    page = 1
    while len(commits) < max_commits:
        req = urllib.request.Request(
            f"https://api.github.com/repos/{HOMEBREW_CASK_REPO}/commits?path={path}&per_page=100&page={page}",
            headers={"User-Agent": "jige"},
        )
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                batch = json.load(r)
        except Exception:
            break
        if not batch:
            break
        commits.extend(batch)
        if len(batch) < 100:
            break
        page += 1
    return commits[:max_commits]


def find_legacy_commit_live(token: str, target_major: int, cpu: str, max_candidates: int = 12) -> dict | None:
    """AI 판단 없이 기계적으로: Homebrew-Cask의 해당 cask 파일 git 기록을 최신 -> 과거로
    훑으며, 1) depends_on macos: 선언이 있으면 그걸로, 2) 없으면 실제 설치 파일을 받아
    Info.plist의 LSMinimumSystemVersion을 직접 읽어서 이 macOS에서 동작하는 버전을 찾음.
    tools/legacy_finder.py와 같은 로직 — jige install 중 즉석 호출용으로 이식함."""
    path = cask_rb_path(token)
    commits = list_cask_commits(path)
    seen_mm: set[str] = set()
    for c in commits:
        sha = c["sha"]
        commit_url = f"https://raw.githubusercontent.com/{HOMEBREW_CASK_REPO}/{sha}/{path}"
        text = fetch_raw_github(commit_url)
        if not text:
            continue
        parsed = parse_cask_rb(text)
        version = parsed["version"]
        if not version:
            continue
        mm = ".".join(version.split(",")[0].split(".")[:2])
        if mm in seen_mm:
            continue
        seen_mm.add(mm)

        dep = parsed["depends_on_macos"]
        if dep:
            floor = depends_on_macos_floor(dep)
            if floor and target_major >= float(floor):
                return {"commit_url": commit_url, "found_by": "depends_on", "confirmations": []}
            if floor:
                continue  # 명시적으로 이 macOS는 안 된다고 돼 있음 — 다음 과거 버전으로

        if not parsed["arch_map"] or not parsed["sha256"] or not parsed["url_template"] or not parsed["app"]:
            continue  # .pkg거나 정규식으로 못 읽는 형태 — 실측 불가, 건너뜀

        which = "arm" if cpu == "arm64" else "intel"
        arch_literal = parsed["arch_map"][which]
        dl_url = resolve_cask_rb_url(parsed["url_template"], version, arch_literal)
        if not dl_url:
            continue
        tmp = Path(tempfile.mkdtemp()) / f"{token}-{mm}.dmg"
        try:
            download(dl_url, tmp)
        except Exception:
            continue
        mount_point = attach_dmg(tmp, f"{token}-{mm}")
        try:
            apps = list(mount_point.glob("*.app"))
            min_os = None
            if apps:
                plist_path = apps[0] / "Contents" / "Info.plist"
                if plist_path.exists():
                    with open(plist_path, "rb") as f:
                        min_os = plistlib.load(f).get("LSMinimumSystemVersion")
        finally:
            detach_dmg(mount_point)
        if min_os and tuple(int(p) for p in min_os.split(".")) <= (target_major, 9999):
            return {"commit_url": commit_url, "found_by": "info_plist", "confirmations": []}

        if len(seen_mm) >= max_candidates:
            break
    return None


def fetch_raw_github(url: str) -> str | None:
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            return r.read().decode("utf-8", errors="replace")
    except Exception:
        return None


