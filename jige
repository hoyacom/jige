def sw_vers_codename() -> str:
    ver = subprocess.check_output(["sw_vers", "-productVersion"], text=True).strip()
    major = ver.split(".")[0]
    codename = MACOS_CODENAME.get(major)
    if not codename:
        sys.exit(f"알 수 없는 macOS 메이저버전: {major} — MACOS_CODENAME 표에 추가해야 함")
    return codename


def arch() -> str:
    return subprocess.check_output(["uname", "-m"], text=True).strip()


def macos_version_tuple() -> tuple[int, ...]:
    ver = subprocess.check_output(["sw_vers", "-productVersion"], text=True).strip()
    return tuple(int(p) for p in ver.split("."))


def _pad_version_tuples(*versions: tuple[int, ...]) -> list[tuple[int, ...]]:
    width = max(len(v) for v in versions)
    return [v + (0,) * (width - len(v)) for v in versions]


def meets_min_macos(min_version: str) -> bool:
    """min_version: "12" 또는 "12.0" 같은 문자열. 이 기기가 그 버전 이상인지."""
    required = tuple(int(p) for p in str(min_version).split("."))
    current = macos_version_tuple()
    current, required = _pad_version_tuples(current, required)
    return current >= required


def check_macos_requirement(min_version: str | None, app_label: str) -> None:
    if not min_version or current_os() != "macos":
        return
    if not meets_min_macos(min_version):
        current = ".".join(str(p) for p in macos_version_tuple())
        legacy_path = f"recipes/legacy/{app_label}.json"
        if load_legacy_versions(app_label):
            # 이미 파일이 있음 — 이 macOS는 못 커버하는 것뿐이니 새 버전 항목을 보태야 함
            action_url = github_edit_url(legacy_path)
            action_hint = "기존 파일에 이 macOS용 버전 추가"
        else:
            # 아직 파일이 없음 — 양식이 미리 채워진 "새 파일 만들기" 링크로 안내
            action_url = github_new_file_url(legacy_path, LEGACY_ENTRY_TEMPLATE)
            action_hint = "새 파일 만들기(양식 미리 채워짐)"
        issue_body = f"토큰: {app_label}\n이 기기: macOS {current}\n최신판 요구: macOS {min_version} 이상"
        issue_url = github_new_issue_url(f"legacy: {app_label}", issue_body)
        sys.exit(
            f"'{app_label}'는 macOS {min_version} 이상이 필요한데 이 기기는 {current}입니다.\n"
            f"-> 설치해도 실행이 안 될 가능성이 높아 다운로드 전에 중단합니다.\n"
            f"-> 이 macOS에서도 쓸 수 있는 구버전을 공식 홈페이지 등에서 확인하셨다면,\n"
            f"   {legacy_path}에 추가해주세요 ({action_hint}): {action_url}\n"
            f"   (또는 이슈로 제보: {issue_url})"
        )


def current_os() -> str:
    system = platform.system()
    return {"Darwin": "macos", "Linux": "linux"}.get(system, system.lower())


# ---------------------------------------------------------------------------
# recipes/legacy/<token>.json: Homebrew-Cask의 depends_on.macos엔 없는
# "최신판이 이 macOS를 더 이상 지원 안 함" 지식을 jige가 직접 큐레이션해두는 곳.
# (예: VirtualBox 7.2부터 macOS 13 이상 필요 — Oracle 공식 문서 기준, cask JSON엔
#  이 정보 자체가 없어서 자동으로 알아낼 방법이 없음.)
# ---------------------------------------------------------------------------

def load_legacy_versions(token: str) -> list[dict]:
    """1) 이 체크아웃의 로컬 recipes/legacy/<token>.json이 있으면 그걸 그대로 씀
    (jige 자체를 개발 중일 때처럼). 2) 없으면 GitHub의 recipes/legacy/<token>.json을
    load_homebrew_index()와 똑같은 24시간 캐시 패턴으로 받아옴 — 그래서 누군가의 PR이
    main에 머지되는 순간부터, jige 코드 자체를 업데이트(git pull)하지 않아도 하루 안에
    모든 사용자에게 그 정보가 퍼짐(코드 업데이트와 데이터 갱신이 분리됨)."""
    local_path = LOCAL_LEGACY_DIR / f"{token}.json"
    if local_path.exists():
        try:
            return json.loads(local_path.read_text()).get("versions", [])
        except json.JSONDecodeError:
            return []

    cache_dir = INDEX_CACHE_DIR / "legacy"
    cache_path = cache_dir / f"{token}.json"
    if not cache_path.exists() or (time.time() - cache_path.stat().st_mtime) > INDEX_MAX_AGE_SECONDS:
        cache_dir.mkdir(parents=True, exist_ok=True)
        url = f"{JIGE_LEGACY_RAW_BASE}/{urllib.parse.quote(token, safe='')}.json"
        try:
            _download_json(url, cache_path)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                # 이 토큰엔 큐레이션된 대체판이 없다는 뜻 — 정상. 그것도 캐시해둬서
                # 매 검색마다 다시 404를 때리지 않게 함.
                cache_path.write_text("{}")
            elif not cache_path.exists():
                return []
        except Exception:
            if not cache_path.exists():
                return []

    try:
        return json.loads(cache_path.read_text()).get("versions", [])
    except json.JSONDecodeError:
        return []


def macos_in_range(entry: dict) -> bool:
    """이 머신의 macOS가 entry에 적힌 min_macos~max_macos 사이인지.
    max_macos는 끝자리를 생략하면(예: "12") 그 메이저 버전 전체(12.x.y 전부)를
    포함하는 뜻 — 0으로 패딩하면 "12"가 "12.0.0"만 가리키게 돼서 12.7.6 같은
    실제 기기가 범위 밖으로 잘못 빠지는 경계 버그가 있었음."""
    current = macos_version_tuple()
    lo = tuple(int(p) for p in str(entry["min_macos"]).split("."))
    hi = tuple(int(p) for p in str(entry["max_macos"]).split("."))
    width = max(len(current), len(lo), len(hi))
    current_p = current + (0,) * (width - len(current))
    lo_p = lo + (0,) * (width - len(lo))
    hi_p = hi + (9999,) * (width - len(hi))
    return lo_p <= current_p <= hi_p


def pick_legacy_for_this_mac(token: str) -> dict | None:
    """이 머신이 쓸 수 있는데(macos_in_range) 최신판은 요구하는 macOS를
    못 만족하는(latest_min_macos) 큐레이션 항목이 있으면 그걸 반환."""
    if current_os() != "macos":
        return None
    for entry in load_legacy_versions(token):
        if macos_in_range(entry) and not meets_min_macos(entry["latest_min_macos"]):
            return entry
    return None


