from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import platform
import plistlib
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

__version__ = "0.1.0"

REPO_ROOT = Path(__file__).resolve().parent
LOCAL_RECIPES_DIR = REPO_ROOT / "recipes"
CACHE_DIR = Path.home() / "Library" / "Caches" / "jige" / "downloads"
INDEX_CACHE_DIR = Path.home() / "Library" / "Caches" / "jige" / "index"
INDEX_MAX_AGE_SECONDS = 24 * 3600
STATE_FILE = Path.home() / "Library" / "Application Support" / "jige" / "installed.json"

HOMEBREW_CASK_API = "https://formulae.brew.sh/api/cask/{token}.json"
HOMEBREW_BULK_API = "https://formulae.brew.sh/api/{kind}.json"  # kind: cask | formula
MACPORTS_SEARCH_API = "https://ports.macports.org/api/v1/ports/"

SOURCE_LABEL = {
    "homebrew-cask": "Homebrew(Cask)",
    "homebrew-formula": "Homebrew(CLI)",
    "macports": "MacPorts",
    "local": "자체 레포지토리",
}

MACOS_CODENAME = {
    "10.15": "catalina", "11": "big_sur", "12": "monterey", "13": "ventura",
    "14": "sonoma", "15": "sequoia", "26": "tahoe", "27": "golden_gate",
}


def sw_vers_codename() -> str:
    ver = subprocess.check_output(["sw_vers", "-productVersion"], text=True).strip()
    major = ver.split(".")[0]
    codename = MACOS_CODENAME.get(major)
    if not codename:
        sys.exit(f"알 수 없는 macOS 메이저버전: {major} — MACOS_CODENAME 표에 추가해야 함")
    return codename


def arch() -> str:
    return subprocess.check_output(["uname", "-m"], text=True).strip()


def current_os() -> str:
    system = platform.system()
    return {"Darwin": "macos", "Linux": "linux"}.get(system, system.lower())


# ---------------------------------------------------------------------------
# search: Homebrew(cask+formula, mac+linux 공용) + MacPorts(mac) + 자체 레포지토리
# ---------------------------------------------------------------------------

def _download_json(url: str, dest: Path) -> None:
    print(f"(처음 검색이거나 캐시가 24시간 지남 — {dest.name} 새로 받는 중...)", file=sys.stderr)
    tmp = dest.with_suffix(dest.suffix + ".part")
    urllib.request.urlretrieve(url, tmp)
    tmp.rename(dest)


def load_homebrew_index(kind: str) -> list[dict]:
    """kind: 'cask' 또는 'formula'. 전체 목록을 로컬에 캐시해서 재사용."""
    INDEX_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    dest = INDEX_CACHE_DIR / f"{kind}.json"
    if not dest.exists() or (time.time() - dest.stat().st_mtime) > INDEX_MAX_AGE_SECONDS:
        try:
            _download_json(HOMEBREW_BULK_API.format(kind=kind), dest)
        except Exception as e:  # 네트워크 문제 등 — 캐시가 있으면 그거라도 쓴다
            if not dest.exists():
                print(f"Homebrew {kind} 인덱스를 못 받았음: {e}", file=sys.stderr)
                return []
    return json.loads(dest.read_text())


def _rank(query: str, *fields: str) -> int:
    """낮을수록 더 관련 있음. 매칭 안 되면 None 대신 큰 값을 돌려주는 쪽에서 걸러냄."""
    q = query.lower()
    for i, field in enumerate((f.lower() for f in fields if f)):
        if field == q:
            return i * 10 + 0
        if field.startswith(q):
            return i * 10 + 1
        if q in field:
            return i * 10 + 2
    return 999


def search_homebrew(query: str) -> list[dict]:
    hits = []
    for kind, source in (("cask", "homebrew-cask"), ("formula", "homebrew-formula")):
        for entry in load_homebrew_index(kind):
            if kind == "cask":
                token = entry.get("token", "")
                display_name = entry.get("name")
                display_name = display_name[0] if isinstance(display_name, list) else (display_name or token)
                version = entry.get("version", "?")
            else:  # formula: name은 그냥 문자열이고 그 자체가 설치 식별자
                token = entry.get("name", "")
                display_name = token
                version = (entry.get("versions") or {}).get("stable", "?")
            desc = entry.get("desc", "")
            rank = _rank(query, token, display_name, desc)
            if rank < 999:
                hits.append({
                    "name": token,
                    "version": version,
                    "desc": desc,
                    "source": source,
                    "kind": "jim" if kind == "cask" else "dogu",  # jim(짐)=데스크톱 앱, dogu(도구)=CLI
                    "rank": rank,
                })
    return hits


def search_macports(query: str) -> list[dict]:
    if current_os() != "macos":
        return []
    try:
        with urllib.request.urlopen(
            f"{MACPORTS_SEARCH_API}?search={urllib.parse.quote(query)}", timeout=10
        ) as r:
            data = json.load(r)
    except Exception as e:
        print(f"MacPorts 검색 실패(무시하고 계속): {e}", file=sys.stderr)
        return []
    hits = []
    for entry in data.get("results", [])[:30]:
        name = entry.get("name", "")
        desc = entry.get("description", "")
        rank = _rank(query, name, desc)
        hits.append({
            "name": name,
            "version": entry.get("version", "?"),
            "desc": desc,
            "source": "macports",
            "kind": "unknown",  # TODO: 포트파일 상세조회(app_dir 등)로 jim/dogu 구분 보강
            "rank": rank,
        })
    return hits


def search_local_recipes(query: str) -> list[dict]:
    hits = []
    if not LOCAL_RECIPES_DIR.exists():
        return hits
    for path in LOCAL_RECIPES_DIR.glob("*.json"):
        try:
            entry = json.loads(path.read_text())
        except json.JSONDecodeError:
            continue
        name = entry.get("name", path.stem)
        name = name[0] if isinstance(name, list) else name
        desc = entry.get("desc", "")
        rank = _rank(query, path.stem, name, desc)
        if rank < 999:
            hits.append({
                "name": path.stem,
                "version": entry.get("version", "?"),
                "desc": desc,
                "source": "local",
                "kind": entry.get("kind", "unknown"),  # 레시피에 직접 적어두면 됨: "jim"(데스크톱 앱) | "dogu"(CLI)
                "rank": rank,
            })
    return hits


def cmd_search(query: str, limit_per_source: int = 8) -> None:
    all_hits = search_local_recipes(query) + search_macports(query) + search_homebrew(query)
    if not all_hits:
        print(f"'{query}' 검색 결과 없음 (Homebrew / MacPorts / 자체 레포지토리 전부).")
        return

    by_source: dict[str, list[dict]] = {}
    for h in all_hits:
        by_source.setdefault(h["source"], []).append(h)

    rows = []
    for source, hits in by_source.items():
        hits.sort(key=lambda h: h["rank"])
        rows.extend(hits[:limit_per_source])
    rows.sort(key=lambda h: h["rank"])

    name_w = max(4, min(28, max(len(h["name"]) for h in rows)))
    print(f"{'이름':<{name_w}}  {'종류':<8}  {'분류':<16}  {'버전':<12}  설명")
    print("-" * (name_w + 8 + 16 + 12 + 40))
    for h in rows:
        desc = (h["desc"] or "")[:60]
        print(f"{h['name']:<{name_w}}  {h['kind']:<8}  {SOURCE_LABEL[h['source']]:<16}  {h['version']:<12}  {desc}")

    print()
    print("설치: jige install <이름>  (Homebrew(Cask) 항목만 지금 바로 자동 설치 지원 — 나머지는 다음 단계에서 연결)")


def fetch_recipe(token: str) -> tuple[dict, str]:
    """(레시피, 출처설명) 반환. 로컬 recipes/ 우선, 없으면 Homebrew-Cask API."""
    local_path = LOCAL_RECIPES_DIR / f"{token}.json"
    if local_path.exists():
        return json.loads(local_path.read_text()), f"로컬 레시피 ({local_path})"

    url = HOMEBREW_CASK_API.format(token=token)
    try:
        with urllib.request.urlopen(url, timeout=15) as r:
            return json.load(r), "Homebrew-Cask 공개 레시피"
    except urllib.error.HTTPError as e:
        if e.code == 404:
            sys.exit(
                f"'{token}'는 Homebrew-Cask에도 로컬 recipes/에도 없습니다.\n"
                f"-> recipes/{token}.json 을 같은 스키마로 직접 추가하면 설치할 수 있습니다."
            )
        raise


def pick_url_sha(recipe: dict, cpu: str, codename: str) -> tuple[str, str]:
    if cpu == "arm64":
        return recipe["url"], recipe["sha256"]
    variations = recipe.get("variations") or {}
    v = variations.get(codename)
    if v:
        return v["url"], v["sha256"]
    return recipe["url"], recipe["sha256"]  # Intel 전용 override가 없으면 기본값


def sha256_of(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def download(url: str, dest: Path) -> None:
    if dest.exists():
        print(f"캐시 사용: {dest.name}")
        return
    print(f"다운로드: {url}")
    tmp = dest.with_suffix(dest.suffix + ".part")
    urllib.request.urlretrieve(url, tmp)
    tmp.rename(dest)


def install_dmg(dmg_path: Path, app_name: str) -> Path:
    mount_point = Path("/Volumes") / f"jige-{app_name}"
    subprocess.run(["hdiutil", "detach", str(mount_point)], capture_output=True)
    subprocess.run(
        ["hdiutil", "attach", "-nobrowse", "-quiet",
         "-mountpoint", str(mount_point), str(dmg_path)],
        check=True,
    )
    try:
        src = mount_point / app_name
        if not src.exists():
            candidates = list(mount_point.glob("*.app"))
            if not candidates:
                sys.exit(f"DMG 안에서 {app_name} 을 못 찾음: {list(mount_point.iterdir())}")
            src = candidates[0]
        dest = Path("/Applications") / src.name
        if dest.exists():
            print(f"기존 {dest} 교체 (새 버전으로 덮어씀)")
            shutil.rmtree(dest)
        print(f"{src} -> {dest}")
        shutil.copytree(src, dest, symlinks=True)
    finally:
        subprocess.run(["hdiutil", "detach", str(mount_point)], capture_output=True)
    return dest


def installed_version(app_path: Path) -> str | None:
    plist_path = app_path / "Contents" / "Info.plist"
    if not plist_path.exists():
        return None
    with open(plist_path, "rb") as f:
        return plistlib.load(f).get("CFBundleShortVersionString")


def load_state() -> dict:
    if not STATE_FILE.exists():
        return {}
    try:
        return json.loads(STATE_FILE.read_text())
    except json.JSONDecodeError:
        return {}


def save_state(state: dict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, ensure_ascii=False, indent=2))


def cmd_install(token: str) -> None:
    codename = sw_vers_codename()
    cpu = arch()
    print(f"macOS 코드네임: {codename} / 아키텍처: {cpu}")

    recipe, source = fetch_recipe(token)
    print(f"레시피: {recipe.get('name')} ({source}, 등록 버전 {recipe.get('version')})")

    url, sha = pick_url_sha(recipe, cpu, codename)
    print(f"선택된 다운로드: {url}")

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    filename = re.sub(r"[^A-Za-z0-9._-]", "_", url.rsplit("/", 1)[-1])
    dmg_path = CACHE_DIR / f"{token}-{recipe.get('version')}-{filename}"
    download(url, dmg_path)

    actual_sha = sha256_of(dmg_path)
    if actual_sha != sha:
        dmg_path.unlink()
        sys.exit(f"sha256 불일치! 기대값={sha} 실제값={actual_sha} — 다운로드 파일 삭제, 설치 중단.")
    print("sha256 체크섬 일치 확인됨.")

    app_artifact = next(
        (a["app"][0] for a in recipe.get("artifacts", []) if "app" in a), None
    )
    if not app_artifact:
        sys.exit("레시피에 .app 아티팩트가 없음 (dmg가 아닌 다른 설치방식일 수 있음, 아직 미지원)")

    before = installed_version(Path("/Applications") / app_artifact)
    installed_path = install_dmg(dmg_path, app_artifact)
    after = installed_version(installed_path)

    state = load_state()
    state[token] = {
        "app": app_artifact,
        "version": after,
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    save_state(state)

    print()
    print(f"완료: {app_artifact}  {before or '(미설치)'} -> {after}")


def cmd_info(token: str) -> None:
    recipe, source = fetch_recipe(token)
    name = recipe.get("name")
    name = name[0] if isinstance(name, list) else name
    print(f"이름       : {name or token}")
    print(f"출처       : {source}")
    print(f"버전       : {recipe.get('version', '?')}")
    if recipe.get("homepage"):
        print(f"홈페이지   : {recipe['homepage']}")
    if recipe.get("desc"):
        print(f"설명       : {recipe['desc']}")


def cmd_list() -> None:
    state = load_state()
    if not state:
        print("jige로 설치한 게 아직 없습니다.")
        return
    name_w = max(4, max(len(k) for k in state))
    print(f"{'이름':<{name_w}}  {'버전':<14}  설치 시각")
    print("-" * (name_w + 14 + 24))
    for token, info in state.items():
        print(f"{token:<{name_w}}  {info.get('version', '?'):<14}  {info.get('installed_at', '?')}")


def move_to_trash(path: Path) -> Path:
    """brew와 같은 방식: 영구삭제 대신 휴지통행. 이름 겹치면 타임스탬프 붙임."""
    trash = Path.home() / ".Trash"
    trash.mkdir(exist_ok=True)
    dest = trash / path.name
    if dest.exists():
        dest = trash / f"{path.stem}-{int(time.time())}{path.suffix}"
    shutil.move(str(path), str(dest))
    return dest


def cmd_uninstall(token: str, zap: bool = False) -> None:
    state = load_state()
    app_name = (state.get(token) or {}).get("app")
    recipe = None
    if not app_name or zap:
        # jige로 추적 안 된 설치본이어도, 레시피에서 앱 이름을 추론해 시도
        # --zap이면 레시피의 zap 목록(부가 파일 경로)도 필요해서 어차피 가져옴
        recipe, _ = fetch_recipe(token)
        if not app_name:
            app_name = next(
                (a["app"][0] for a in recipe.get("artifacts", []) if "app" in a), None
            )
    if not app_name:
        sys.exit(f"'{token}'의 앱 이름을 찾을 수 없음 — 수동으로 /Applications에서 지워야 함")

    app_path = Path("/Applications") / app_name
    if not app_path.exists():
        print(f"{app_path} 가 이미 없습니다.")
    else:
        dest = move_to_trash(app_path)
        print(f"{app_path} -> 휴지통({dest})")

    if zap:
        # brew uninstall --zap과 동일: 레시피에 적힌 설정/캐시/로그 등 부가 경로까지 정리
        if recipe is None:
            recipe, _ = fetch_recipe(token)
        zap_paths: list[str] = []
        for artifact in recipe.get("artifacts", []):
            for zap_entry in artifact.get("zap", []):
                zap_paths.extend(zap_entry.get("trash", []))
        if not zap_paths:
            print("(zap: 이 레시피엔 정리할 부가 경로가 없음)")
        for raw in zap_paths:
            p = Path(raw.replace("~", str(Path.home()), 1)) if raw.startswith("~") else Path(raw)
            if p.exists():
                dest = move_to_trash(p)
                print(f"zap: {p} -> 휴지통({dest})")
            else:
                print(f"zap: {p} 없음(건너뜀)")

    if token in state:
        del state[token]
        save_state(state)
    print(f"완료: {token} 제거(휴지통행, 영구삭제 아님)")


def cmd_update() -> None:
    """jige 자체 갱신 (brew update / port selfupdate와 같은 역할 — upgrade는 '설치된 앱'용)."""
    if not (REPO_ROOT / ".git").exists():
        sys.exit(f"{REPO_ROOT}가 git 저장소가 아님 — install.sh로 받은 설치가 아닌 듯함")
    before = subprocess.check_output(
        ["git", "-C", str(REPO_ROOT), "rev-parse", "--short", "HEAD"], text=True
    ).strip()
    subprocess.run(["git", "-C", str(REPO_ROOT), "pull", "--ff-only"], check=True)
    after = subprocess.check_output(
        ["git", "-C", str(REPO_ROOT), "rev-parse", "--short", "HEAD"], text=True
    ).strip()
    if before == after:
        print(f"jige는 이미 최신 상태입니다 ({before}).")
    else:
        print(f"jige 갱신됨: {before} -> {after}")


def cmd_upgrade(token: str | None) -> None:
    if token:
        cmd_install(token)
        return
    state = load_state()
    if not state:
        print("jige로 설치한 게 없어서 업그레이드할 대상이 없습니다.")
        return
    for t in list(state.keys()):
        print(f"--- {t} ---")
        try:
            cmd_install(t)
        except SystemExit as e:
            print(f"{t} 업그레이드 실패(건너뜀): {e}")
        print()


def main() -> None:
    # 명령어 이름은 brew/port 둘 다 쓰는 것과 그대로 맞춤
    # (install/search/info/upgrade 공통, uninstall엔 brew의 remove, list엔 port의 installed를 별칭으로 추가)
    parser = argparse.ArgumentParser(prog="jige", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"jige {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    p_install = sub.add_parser("install", help="앱 설치/업데이트 (brew install / port install)")
    p_install.add_argument("token")

    p_search = sub.add_parser("search", help="통합 검색 (brew search / port search)")
    p_search.add_argument("query")

    p_info = sub.add_parser("info", help="상세 정보, 설치 안 함 (brew info / port info)")
    p_info.add_argument("token")

    p_uninstall = sub.add_parser(
        "uninstall", aliases=["remove"], help="제거, 휴지통행 (brew uninstall/remove)"
    )
    p_uninstall.add_argument("token")
    p_uninstall.add_argument(
        "--zap", action="store_true",
        help="앱뿐 아니라 설정/캐시/로그 등 부가 파일까지 정리 (brew uninstall --zap과 동일)"
    )

    sub.add_parser("list", aliases=["installed"], help="jige로 설치한 목록 (brew list / port installed)")

    p_upgrade = sub.add_parser("upgrade", help="설치된 앱 최신판으로 재설치 (brew upgrade / port upgrade)")
    p_upgrade.add_argument("token", nargs="?", default=None, help="생략하면 설치된 전체 업그레이드")

    sub.add_parser("update", help="jige 자체를 최신 코드로 갱신 (brew update / port selfupdate)")

    args = parser.parse_args()
    if args.command == "install":
        cmd_install(args.token)
    elif args.command == "search":
        cmd_search(args.query)
    elif args.command == "info":
        cmd_info(args.token)
    elif args.command in ("uninstall", "remove"):
        cmd_uninstall(args.token, zap=args.zap)
    elif args.command in ("list", "installed"):
        cmd_list()
    elif args.command == "upgrade":
        cmd_upgrade(args.token)
    elif args.command == "update":
        cmd_update()


if __name__ == "__main__":
    main()
