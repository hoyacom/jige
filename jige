def move_to_trash(path: Path) -> Path:
    """brew와 같은 방식: 영구삭제 대신 휴지통행. 이름 겹치면 타임스탬프 붙임."""
    trash = Path.home() / ".Trash"
    trash.mkdir(exist_ok=True)
    dest = trash / path.name
    if dest.exists():
        dest = trash / f"{path.stem}-{int(time.time())}{path.suffix}"
    shutil.move(str(path), str(dest))
    return dest


# ---------------------------------------------------------------------------
# uninstall: cask 레시피의 "uninstall" 단계를 Homebrew와 같은 순서로 실행.
# .app 하나 복사한 앱은 휴지통행으로 끝나지만, .pkg로 깐 앱(Tailscale, VirtualBox 등)은
# 시스템 곳곳에 파일·서비스를 깔아서 레시피에 적힌 정리 단계(pkgutil 영수증 기반 파일
# 삭제, launchctl 서비스 내리기 등)를 돌려야 깨끗이 지워짐. 새 포맷을 만들지 않고 cask의
# 키 이름(quit/launchctl/login_item/script/pkgutil/delete/trash/rmdir)을 그대로 읽음.
# ---------------------------------------------------------------------------

# 실수로라도 절대 지우면 안 되는 디렉터리 — pkgutil 영수증의 빈 디렉터리 정리나 delete 경로가
# 이걸 가리키면 건너뜀 (Homebrew도 비슷한 보호 목록을 둠)
PROTECTED_DIRS = {
    "/", "/Applications", "/Library", "/System", "/Users", "/bin", "/sbin", "/usr", "/usr/bin",
    "/usr/sbin", "/usr/lib", "/usr/libexec", "/usr/share", "/usr/local", "/usr/local/bin",
    "/usr/local/lib", "/usr/local/share", "/usr/local/share/man", "/opt", "/private", "/etc",
    "/var", "/tmp", "/Library/Application Support", "/Library/LaunchAgents",
    "/Library/LaunchDaemons", "/Library/Preferences", "/Library/PrivilegedHelperTools",
    "/Library/Extensions", "/Library/Frameworks", "/Library/Caches", "/Library/Logs",
    "/Library/SystemExtensions", "/Library/Application Scripts", "/Library/Group Containers",
    *(f"/usr/local/share/man/man{n}" for n in range(1, 10)),
}
UNINSTALL_ORDER = ["early_script", "launchctl", "quit", "signal", "login_item", "kext",
                   "script", "pkgutil", "delete", "trash", "rmdir"]


def _as_list(value) -> list:
    if value is None:
        return []
    return value if isinstance(value, list) else [value]


def _expand(raw: str) -> list[Path]:
    """~ 확장 + 와일드카드(레시피에 '~/Library/Application Scripts/*.io.x' 같은 게 있음)."""
    import glob
    s = os.path.expanduser(raw)
    if any(c in s for c in "*?["):
        return [Path(p) for p in sorted(glob.glob(s))]
    return [Path(s)]


def _is_protected(p: Path) -> bool:
    s = os.path.normpath(str(p))
    return s in PROTECTED_DIRS or s == str(Path.home()) or s.count("/") < 2


def _sudo(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(["sudo", *cmd], capture_output=True, text=True)


def _remove_path(p: Path, label: str) -> None:
    if _is_protected(p):
        print(f"{label}: {p} 는 보호된 경로라 건너뜀")
        return
    if not (p.exists() or p.is_symlink()):
        return
    try:
        if p.is_dir() and not p.is_symlink():
            shutil.rmtree(p)
        else:
            p.unlink()
    except PermissionError:
        r = _sudo(["rm", "-rf", str(p)])
        if r.returncode != 0:
            print(f"{label}: {p} 삭제 실패 — {r.stderr.strip()}")
            return
    print(f"{label}: {p} 삭제")


def _uninstall_pkgutil(pattern: str) -> None:
    """설치 영수증(pkgutil)에 기록된 파일만 지우고, 비게 된 디렉터리를 정리한 뒤 영수증을 지움."""
    ids = subprocess.run(["pkgutil", f"--pkgs={pattern}"], capture_output=True, text=True).stdout.split()
    if not ids:
        print(f"pkgutil: '{pattern}' 설치 기록 없음(건너뜀)")
        return
    for pkg_id in ids:
        info = subprocess.run(["pkgutil", "--pkg-info-plist", pkg_id], capture_output=True)
        try:
            meta = plistlib.loads(info.stdout)
        except Exception:
            print(f"pkgutil: {pkg_id} 정보 읽기 실패(건너뜀)")
            continue
        base = Path(meta.get("volume", "/")) / meta.get("install-location", "").lstrip("/")
        def listing(flag: str) -> list[Path]:
            out = subprocess.run(["pkgutil", flag, "--files", pkg_id], capture_output=True, text=True).stdout
            return [base / line for line in out.splitlines() if line.strip()]
        files = [f for f in listing("--only-files") if f.exists() or f.is_symlink()]
        dirs = sorted(listing("--only-dirs"), key=lambda d: len(d.parts), reverse=True)
        print(f"pkgutil: {pkg_id} — 파일 {len(files)}개 삭제")
        for i in range(0, len(files), 200):  # 명령줄 길이 제한 때문에 나눠서
            chunk = [str(f) for f in files[i:i + 200] if not _is_protected(f)]
            if chunk:
                r = _sudo(["rm", "-f", *chunk])
                if r.returncode != 0:
                    print(f"  일부 삭제 실패: {r.stderr.strip()[:200]}")
        for d in dirs:
            if d.is_dir() and not d.is_symlink() and not _is_protected(d):
                _sudo(["rmdir", str(d)])  # 비어 있을 때만 지워짐 — 다른 것도 들어 있으면 그대로 둠
        _sudo(["pkgutil", "--forget", pkg_id])


def _launchctl_remove(label: str) -> None:
    uid = os.getuid()
    for domain, use_sudo in ((f"gui/{uid}", False), ("system", True)):
        target = f"{domain}/{label}"
        check = (_sudo if use_sudo else lambda c: subprocess.run(c, capture_output=True, text=True))
        if check(["launchctl", "print", target]).returncode == 0:
            check(["launchctl", "bootout", target])
            print(f"launchctl: {target} 내림")
    for plist in (Path.home() / "Library/LaunchAgents", Path("/Library/LaunchAgents"),
                  Path("/Library/LaunchDaemons")):
        _remove_path(plist / f"{label}.plist", "launchctl")


def run_uninstall_steps(steps: list[dict]) -> None:
    by_key: dict[str, list] = {}
    for entry in steps:
        for key, value in entry.items():
            by_key.setdefault(key, []).extend(_as_list(value))
    if any(k in by_key for k in ("pkgutil", "delete", "rmdir", "launchctl", "script", "early_script")):
        print("관리자 권한(sudo)이 필요할 수 있습니다 — 비밀번호를 물으면 입력하세요.")
        subprocess.run(["sudo", "-v"])
    for key in UNINSTALL_ORDER:
        for value in by_key.get(key, []):
            if key == "quit":
                running = subprocess.run(
                    ["osascript", "-e", f'application id "{value}" is running'],
                    capture_output=True, text=True).stdout.strip()
                if running == "true":
                    subprocess.run(["osascript", "-e", f'tell application id "{value}" to quit'],
                                   capture_output=True)
                    print(f"quit: {value} 종료")
            elif key == "launchctl":
                _launchctl_remove(value)
            elif key == "login_item":
                r = subprocess.run(
                    ["osascript", "-e", f'tell application "System Events" to delete login item "{value}"'],
                    capture_output=True, text=True)
                if r.returncode == 0:
                    print(f"login_item: {value} 제거")
            elif key in ("script", "early_script"):
                spec = value if isinstance(value, dict) else {"executable": value}
                exe = Path(os.path.expanduser(spec.get("executable", "")))
                if exe.exists():
                    cmd = [str(exe), *[str(a) for a in _as_list(spec.get("args"))]]
                    print(f"{key}: {' '.join(cmd)}")
                    subprocess.run(["sudo", *cmd] if spec.get("sudo") else cmd)
            elif key == "pkgutil":
                _uninstall_pkgutil(value)
            elif key == "delete":
                for p in _expand(value):
                    _remove_path(p, "delete")
            elif key == "trash":
                for p in _expand(value):
                    if (p.exists() or p.is_symlink()) and not _is_protected(p):
                        try:
                            print(f"trash: {p} -> 휴지통({move_to_trash(p)})")
                        except PermissionError:
                            _remove_path(p, "trash")
            elif key == "rmdir":
                for p in _expand(value):
                    if p.is_dir() and not _is_protected(p):
                        _sudo(["rmdir", str(p)])
            else:  # signal, kext — 지금은 직접 처리 안 함(드묾, kext는 macOS가 더 이상 권장 안 함)
                print(f"({key} 단계는 jige가 아직 처리 안 함 — 건너뜀: {value})")


def cmd_uninstall(token: str, zap: bool = False) -> None:
    state = load_state()
    entry = state.get(token) or {}

    if entry.get("source") == "brew-formula":
        # formula는 jige가 설치도 brew에 위임했으니 제거도 동일하게 위임 — fetch_recipe는
        # cask/로컬/MAS만 봐서 formula 토큰을 못 찾고 아래 블록이 엉뚱하게 실패함.
        name = entry.get("name", token)
        if not shutil.which("brew"):
            sys.exit(f"brew가 없어서 제거 못 함 — 'brew uninstall {name}'로 직접 제거하세요.")
        try:
            subprocess.run(["brew", "uninstall", name], check=True)
        except subprocess.CalledProcessError as e:
            sys.exit(f"{token}: brew uninstall 실패 (종료 코드 {e.returncode})")
        del state[token]
        save_state(state)
        print(f"완료: {token} 제거 (brew uninstall)")
        return

    if entry.get("source") == "macports":
        name = entry.get("name", token)
        if not shutil.which("port"):
            sys.exit(f"port가 없어서 제거 못 함 — 'sudo port uninstall {name}'로 직접 제거하세요.")
        try:
            subprocess.run(["sudo", "port", "uninstall", name], check=True)
        except subprocess.CalledProcessError as e:
            sys.exit(f"{token}: port uninstall 실패 (종료 코드 {e.returncode})")
        del state[token]
        save_state(state)
        print(f"완료: {token} 제거 (port uninstall)")
        return

    try:
        recipe, _ = fetch_recipe(token)
    except (SystemExit, Exception):
        if not entry:
            raise
        recipe = {}  # 오프라인 등 — 기록된 .app만이라도 지움
        print("(레시피를 못 가져옴 — 기록된 앱만 지웁니다)")
    artifacts = recipe.get("artifacts", [])

    # 1. 레시피의 uninstall 단계 (.pkg 앱은 여기서 실제 파일이 지워짐)
    steps = [s for a in artifacts for s in a.get("uninstall", [])]
    if steps:
        run_uninstall_steps(steps)
    elif entry.get("pkg"):
        print("이 레시피엔 uninstall 단계가 없어서 .pkg가 깐 파일은 직접 지워야 할 수 있습니다.")

    # 2. 앱·앱 폴더(휴지통행). 설치 때 기록한 실제 경로가 있으면 그걸, 없으면(예전 jige로
    #    설치했거나 기록이 없을 때) 레시피의 target(이름 바꿔 설치하는 앱 포함)으로 계산
    version = str(recipe.get("version", ""))
    app_paths = [Path(p) for p in entry.get("apps", [])]
    if not app_paths:
        for a in artifacts:
            for key in ("app", "suite"):
                if key in a:
                    raw = a.get("target") or f"/Applications/{Path(a[key][0]).name}"
                    app_paths.append(_expand_cask_path(raw, token, version, Path("/")))
    if not app_paths and entry.get("app", "").endswith(".app"):
        app_paths = [APPDIR / entry["app"]]
    for app_path in app_paths:
        if app_path.exists():
            print(f"{app_path} -> 휴지통({move_to_trash(app_path)})")
        elif not steps:
            print(f"{app_path} 가 이미 없습니다.")
    if not app_paths and not steps:
        sys.exit(f"'{token}'을(를) 지우는 방법을 레시피에서 못 찾음 — 수동으로 지워야 함")

    if zap:
        # brew uninstall --zap과 동일: 레시피에 적힌 설정/캐시/로그 등 부가 경로까지 정리
        zap_steps = [s for a in artifacts for s in a.get("zap", [])]
        if not zap_steps:
            print("(zap: 이 레시피엔 정리할 부가 경로가 없음)")
        run_uninstall_steps(zap_steps)

    if token in state:
        del state[token]
        save_state(state)
    if steps:
        # pkgutil/delete로 지운 시스템 파일은 휴지통에 안 감(brew도 같음) — 오해 없게 구분
        print(f"완료: {token} 제거 (앱은 휴지통, 설치 패키지가 깐 파일은 삭제)")
    else:
        print(f"완료: {token} 제거(휴지통행, 영구삭제 아님)")


def cmd_update() -> None:
    """jige 자체 갱신 (brew update / port selfupdate와 같은 역할 — upgrade는 '설치된 앱'용)."""
    if not (REPO_ROOT / ".git").exists():
        sys.exit(f"{REPO_ROOT}가 git 저장소가 아님 — install.sh로 받은 설치가 아닌 듯함")
    before = subprocess.check_output(
        ["git", "-C", str(REPO_ROOT), "rev-parse", "--short", "HEAD"], text=True
    ).strip()
    subprocess.run(["git", "-C", str(REPO_ROOT), "pull", "--ff-only"], check=True)
    after = subprocess.check_output(
        ["git", "-C", str(REPO_ROOT), "rev-parse", "--short", "HEAD"], text=True
    ).strip()
    if before == after:
        print(f"jige는 이미 최신 상태입니다 ({before}).")
    else:
        print(f"jige 갱신됨: {before} -> {after}")
    _hint_completion_setup()


def _hint_completion_setup() -> None:
    """탭 자동완성이 생기기 전에 설치한 사람은 셸 설정에 source 줄이 없음 —
    update는 git pull만 하고 남의 설정 파일은 안 건드리니, 없을 때 안내만 함."""
    shell = Path(os.environ.get("SHELL", "")).name
    home = Path.home()
    if shell == "zsh":
        rcs = [Path(os.environ.get("ZDOTDIR", home)) / ".zshrc"]
    elif shell == "bash":
        rcs = [home / n for n in (".bash_profile", ".bash_login", ".profile", ".bashrc")]
    else:
        return
    for rc in rcs:
        try:
            if "jige/completions/jige." in rc.read_text(errors="replace"):
                return
        except OSError:
            continue
    # 이 컴의 절대경로(/Users/<이름>/...)를 박지 말고 $HOME으로 — install.sh가 넣는 줄과
    # 같은 모양이 되고, dotfiles를 다른 Mac에 동기화해도 그대로 동작함
    script = str(COMPLETION_DIR / f"jige.{shell}")
    home_str = str(home)
    if script.startswith(home_str + os.sep):
        script = "$HOME" + script[len(home_str):]
    guard = ""
    if shell == "zsh":
        target = rcs[0]
    elif sys.platform == "darwin":
        # install.sh와 같은 규칙: 로그인 bash는 셋 중 처음 있는 파일 하나만 읽음
        target = next((p for p in rcs[:3] if p.exists()), home / ".bash_profile")
        guard = '[ -n \"$BASH_VERSION\" ] && '
    else:
        target = home / ".bashrc"
    print()
    print("팁: 탭 자동완성을 켜려면 아래 한 줄을 실행하세요 (새 터미널 창부터 적용):")
    target_str = str(target)
    if target_str.startswith(home_str + os.sep):
        target_str = "~" + target_str[len(home_str):]
    # 작은따옴표 안이라 $HOME은 rc 파일에 글자 그대로 들어가고, 셸이 뜰 때마다 그 컴 기준으로 풀림
    print(f"  echo '{guard}[ -f \"{script}\" ] && source \"{script}\"' >> {target_str}")


def cmd_upgrade(token: str | None, latest: bool = False) -> None:
    if token:
        cmd_install(token, latest=latest)
        return
    state = load_state()
    if not state:
        print("jige로 설치한 게 없어서 업그레이드할 대상이 없습니다.")
        return
    for tok in list(state.keys()):
        print(f"--- {tok} ---")
        try:
            cmd_install(tok, latest=latest)
        except SystemExit as e:
            print(f"{tok} 업그레이드 실패(건너뜀): {e}")
        print()


# ---------------------------------------------------------------------------
# 탭 자동완성: completions/jige.{zsh,bash}가 `jige __complete <종류> [접두어]`를
# 불러서 후보를 받아감. 탭 누를 때마다 실행되니 네트워크는 절대 안 타고, 19M+32M짜리
# 인덱스 JSON을 매번 파싱하지 않도록 이름만 뽑은 tokens.txt를 따로 캐시해 둠.
# ---------------------------------------------------------------------------

COMPLETION_DIR = REPO_ROOT / "completions"
TOKENS_CACHE = INDEX_CACHE_DIR / "tokens.txt"

# (이름, 도움말 키) — 별칭도 같이 넣어둬야 brew/port 습관대로 쳐도 완성됨
COMPLETION_COMMANDS = [
    ("install", "help_install"), ("search", "help_search"), ("info", "help_info"),
    ("uninstall", "help_uninstall"), ("remove", "help_uninstall"),
    ("list", "help_list"), ("installed", "help_list"),
    ("upgrade", "help_upgrade"), ("update", "help_update"),
    ("config", "help_config"), ("completion", "help_completion"),
]


def _completion_tokens() -> list[str]:
    """Homebrew cask+formula 이름 + 로컬 레시피 이름을 tokens.txt에 캐시해서 반환.

    셸 스크립트는 평소엔 tokens.txt를 직접 읽고(pyenv shim 등으로 python 기동만
    0.5초 넘게 걸리는 기기가 있어서 탭마다 python을 띄우면 답답함), 인덱스 JSON이
    tokens.txt보다 새로울 때(=jige search가 방금 새로 받아옴)만 이걸 불러 다시 뽑음.
    인덱스가 아예 없으면(아직 search를 한 번도 안 함) 로컬 레시피만 — 탭 한 번에
    50MB 다운로드는 안 함."""
    sources = [INDEX_CACHE_DIR / "cask.json", INDEX_CACHE_DIR / "formula.json"]
    newest = max((p.stat().st_mtime for p in sources if p.exists()), default=0)
    if LOCAL_RECIPES_DIR.exists():
        newest = max(newest, LOCAL_RECIPES_DIR.stat().st_mtime)
    if TOKENS_CACHE.exists() and TOKENS_CACHE.stat().st_mtime >= newest:
        return TOKENS_CACHE.read_text().split()

    names: set[str] = set()
    for path in sources:
        if not path.exists():
            continue
        try:
            for entry in json.loads(path.read_text()):
                name = entry.get("token") or entry.get("name")
                if name:
                    names.add(name)
        except (json.JSONDecodeError, OSError):
            continue
    if LOCAL_RECIPES_DIR.exists():
        names.update(p.stem for p in LOCAL_RECIPES_DIR.glob("*.json"))
    try:
        INDEX_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        TOKENS_CACHE.write_text("\n".join(sorted(names)) + "\n")
    except OSError:
        pass
    return sorted(names)


def cmd_complete(kind: str, prefix: str = "") -> None:
    """숨은 명령 — 셸 완성 스크립트 전용. 후보를 한 줄에 하나씩 출력."""
    if kind == "commands":
        # zsh _describe 형식(이름:설명). 설명 안의 ':'는 구분자로 오인되니 이스케이프
        for name, key in COMPLETION_COMMANDS:
            print(f"{name}:{t(key).replace(':', chr(92) + ':')}")
        return
    if kind == "tokens":
        candidates = _completion_tokens()
    elif kind == "installed":
        candidates = sorted(load_state())
    else:
        return
    low = prefix.lower()
    out = [c for c in candidates if c.lower().startswith(low)]
    try:
        sys.stdout.write("\n".join(out) + ("\n" if out else ""))
    except BrokenPipeError:
        pass


def cmd_completion(shell: str) -> None:
    path = COMPLETION_DIR / f"jige.{shell}"
    if not path.exists():
        sys.exit(f"지원하지 않는 셸: {shell} (zsh 또는 bash)")
    sys.stdout.write(path.read_text())


def main() -> None:
    # 탭 누를 때마다 불리는 경로라 argparse/도움말 문자열 생성까지 건너뛰고 바로 처리
    if len(sys.argv) >= 3 and sys.argv[1] == "__complete":
        cmd_complete(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else "")
        return

    # 명령어 이름은 brew/port 둘 다 쓰는 것과 그대로 맞춤
    # (install/search/info/upgrade 공통, uninstall엔 brew의 remove, list엔 port의 installed를 별칭으로 추가)
    parser = argparse.ArgumentParser(prog="jige", description=t("app_description"))
    parser.add_argument("--version", action="version", version=f"jige {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    p_install = sub.add_parser("install", help=t("help_install"))
    p_install.add_argument("token")
    p_install.add_argument(
        "--mas", action="store_true",
        help="이번 한 번만 Mac App Store도 뒤짐 ('jige config mas on' 없이 일회성으로 켜는 옵션)"
    )
    p_install.add_argument(
        "--latest", action="store_true",
        help="이 macOS에 안 맞을 수 있어도 묻지 않고 최신판으로 강행 (recipes/legacy/ 큐레이션 무시)"
    )
    p_install.add_argument(
        "--find-legacy", action="store_true",
        help="저장소에 대체판이 없어도 Homebrew-Cask 커밋 기록에서 즉석으로 찾아봄 (시간 좀 걸림)"
    )
    p_install.add_argument(
        "--repo", default=None,
        help="토큰이 여러 레포에 동시에 있을 때 어디서 가져올지 지정 (brew / port / 등록한 사용자 레포 이름)"
    )

    p_search = sub.add_parser(
        "search", help=t("help_search"),
        description=(
            t("help_search") + "\n\n"
            "결과의 기호: "
            f"{kind_icon('jim')} GUI 앱(jim)  {kind_icon('dogu')} CLI 도구(dogu)  "
            f"* 이미 설치됨  {_sym('▼', 'v')} 이 macOS에 맞춘 대체판"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_search.add_argument("query", nargs="+", help="따로 쳐도 됨(예: jige search Input Source Pro) — 합쳐서 검색")
    p_search.add_argument(
        "--mas", action="store_true",
        help="이번 한 번만 Mac App Store도 뒤짐 ('jige config mas on' 없이 일회성으로 켜는 옵션)"
    )

    p_info = sub.add_parser("info", help=t("help_info"))
    p_info.add_argument("token")
    p_info.add_argument(
        "--repo", default=None,
        help="토큰이 여러 레포에 동시에 있을 때 어디서 가져올지 지정 (brew / port / 등록한 사용자 레포 이름)"
    )

    p_uninstall = sub.add_parser(
        "uninstall", aliases=["remove"], help=t("help_uninstall")
    )
    p_uninstall.add_argument("token")
    p_uninstall.add_argument(
        "--zap", action="store_true",
        help="앱뿐 아니라 설정/캐시/로그 등 부가 파일까지 정리 (brew uninstall --zap과 동일)"
    )

    sub.add_parser("list", aliases=["installed"], help=t("help_list"))

    p_upgrade = sub.add_parser("upgrade", help=t("help_upgrade"))
    p_upgrade.add_argument("token", nargs="?", default=None, help="생략하면 설치된 전체 업그레이드")
    p_upgrade.add_argument(
        "--latest", action="store_true",
        help="이 macOS에 안 맞을 수 있어도 묻지 않고 최신판으로 강행 (recipes/legacy/ 큐레이션 무시)"
    )

    sub.add_parser("update", help=t("help_update"))

    p_config = sub.add_parser("config", help=t("help_config"))
    p_config.add_argument("key", nargs="?", default=None)
    p_config.add_argument("value", nargs="?", default=None)

    p_user_repo = sub.add_parser(
        "user-repo",
        help="사용자 레포지토리(NAS/회사 서버 등) 등록·관리 — jige 공식 레포지토리와 별도"
    )
    ur_sub = p_user_repo.add_subparsers(dest="user_repo_action", required=True)

    p_ur_add = ur_sub.add_parser("add", help="레포지토리 등록")
    p_ur_add.add_argument("name")
    p_ur_add.add_argument("url", help="file:///... , http(s)://... , ssh://user@host/path , 또는 스킴 없는 로컬 경로")
    p_ur_add.add_argument(
        "--bearer-env", default=None,
        help="Bearer 토큰을 읽어올 환경변수 이름 (값 자체는 jige가 저장 안 함, Basic Auth는 ~/.netrc 자동 사용)"
    )

    p_ur_remove = ur_sub.add_parser("remove", aliases=["rm"], help="레포지토리 등록 해제")
    p_ur_remove.add_argument("name")

    ur_sub.add_parser("list", aliases=["ls"], help="등록된 레포지토리 목록 (우선순위 순)")

    p_ur_scan = ur_sub.add_parser(
        "scan",
        help="로컬 경로의 '버전 폴더 안에 파일들' 구조를 훑어서 jige-catalog.json 자동 생성/갱신"
    )
    p_ur_scan.add_argument("path", help="레포지토리 루트 (이 밑에 버전 이름의 폴더들이 있다고 가정)")
    p_ur_scan.add_argument("--token", required=True)
    p_ur_scan.add_argument("--app", default=None, help=".app 번들 이름 (기본: <토큰>.app)")
    p_ur_scan.add_argument("--kind", choices=["jim", "dogu", "unknown"], default="jim")

    p_ur_addfile = ur_sub.add_parser("add-file", help="파일 하나를 레포지토리에 복사하고 카탈로그에 등록")
    p_ur_addfile.add_argument("path", help="레포지토리 루트 (로컬 경로)")
    p_ur_addfile.add_argument("file", help="등록할 파일")
    p_ur_addfile.add_argument("--token", required=True)
    p_ur_addfile.add_argument("--version", required=True)
    p_ur_addfile.add_argument("--platform", choices=["macos", "windows", "linux"], default=None)
    p_ur_addfile.add_argument("--arch", default=None, help="예: arm64, x86_64 (생략하면 전부 지원으로 간주)")
    p_ur_addfile.add_argument("--min-os", default=None, help="예: 12 (생략하면 제한 없음)")

    p_completion = sub.add_parser("completion", help=t("help_completion"))
    p_completion.add_argument("shell", choices=["zsh", "bash"])

    args = parser.parse_args()
    if args.command == "completion":
        cmd_completion(args.shell)
        return
    if args.command == "install":
        cmd_install(
            args.token, mas=args.mas, latest=args.latest, find_legacy=args.find_legacy,
            repo=args.repo,
        )
    elif args.command == "search":
        cmd_search(" ".join(args.query), mas=args.mas)
    elif args.command == "config":
        cmd_config(args.key, args.value)
    elif args.command == "info":
        cmd_info(args.token, repo=args.repo)
    elif args.command in ("uninstall", "remove"):
        cmd_uninstall(args.token, zap=args.zap)
    elif args.command in ("list", "installed"):
        cmd_list()
    elif args.command == "upgrade":
        cmd_upgrade(args.token, latest=args.latest)
    elif args.command == "update":
        cmd_update()
    elif args.command == "user-repo":
        if args.user_repo_action == "add":
            cmd_user_repo_add(args.name, args.url, args.bearer_env)
        elif args.user_repo_action in ("remove", "rm"):
            cmd_user_repo_remove(args.name)
        elif args.user_repo_action in ("list", "ls"):
            cmd_user_repo_list()
        elif args.user_repo_action == "scan":
            cmd_user_repo_scan(args.path, args.token, args.app, args.kind)
        elif args.user_repo_action == "add-file":
            cmd_user_repo_add_file(
                args.path, args.file, args.token, args.version,
                args.platform, args.arch, args.min_os,
            )


if __name__ == "__main__":
    main()
