def offer_github_contribution(title: str, body: str, fallback_edit_path: str | None = None) -> None:
    """gh CLI(설치·로그인돼 있으면)로 터미널에서 바로 이슈를 올리게 묻고, 없거나
    거절하면 웹에서 직접 할 수 있는 링크를 보여줌. 커스텀 서버·PR 자동화는 없음 —
    gh도 안 되면 그냥 사람이 GitHub 웹에서 하는 것뿐."""
    print()
    print("--- 커뮤니티에 공유하기 (선택) ---")
    print(title)
    if shutil.which("gh") and sys.stdin.isatty():
        answer = input("gh CLI로 지금 바로 이슈를 올릴까요? [y/N]: ").strip().lower()
        if answer == "y":
            try:
                subprocess.run(
                    ["gh", "issue", "create", "--repo", JIGE_REPO_SLUG,
                     "--title", title, "--body", body],
                    check=True,
                )
                return
            except Exception as e:
                print(f"(gh issue create 실패: {e} — 아래 링크로 직접 올려주세요)")
    print(f"-> 이슈로 올리기: {github_new_issue_url(title, body)}")
    if fallback_edit_path:
        print(f"-> 또는 파일을 직접 고쳐서 PR 올리기: {github_edit_url(fallback_edit_path)}")


def trust_badge(entry: dict) -> str:
    """search처럼 짧게만 보여줄 때 쓰는 한 토큰짜리 신뢰 단계 표시.
    UTF-8이 아닌 터미널에선 이모지/기호 대신 ASCII로."""
    n = len(entry.get("confirmations") or [])
    if n == 0:
        return _sym("🆕", "NEW")
    if n < 3:
        return _sym(f"✓{n}", f"OK{n}")
    return _sym(f"✓✓{n}", f"OK+{n}")


def trust_label(entry: dict) -> str:
    """recipes/legacy/<token>.json의 confirmations 배열 길이로 신뢰 단계를 보여줌.
    confirmations는 실제로 설치해본 사람들이 GitHub PR로 한 줄씩 추가하는 기록이라,
    jige가 뭘 자동 집계하는 게 아니라 그 배열 길이 자체가 신뢰 단계임."""
    n = len(entry.get("confirmations") or [])
    if n == 0:
        return _sym("🆕", "NEW") + " 방금 등록됨 (공식 문서로 확인, 다른 사용자 확인 아직 없음)"
    if n < 3:
        return _sym("✓", "OK") + f" 실제 설치로 확인됨 ({n}명)"
    return _sym("✓✓", "OK+") + f" 여러 명이 확인함 ({n}명)"


