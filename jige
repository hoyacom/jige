def _download_json(url: str, dest: Path) -> bool:
    """받아서 dest에 저장. 서버에서 바뀐 게 없으면(304) 파일은 그대로 두고 시각만 갱신.
    반환값: 내용이 실제로 바뀌었으면 True.

    formulae.brew.sh는 남의(Homebrew의) 공짜 인프라라 brew 자신처럼 아껴 씀:
    - gzip 요청: cask.json이 19.4MB -> 2.1MB(2026-11-14 실측, 약 1/9)
    - If-Modified-Since: 24시간 지나도 서버 쪽이 안 바뀌었으면 304로 본문 없이 끝남"""
    print(f"(처음 검색이거나 캐시가 24시간 지남 — {dest.name} 확인 중...)", file=sys.stderr)
    req = urllib.request.Request(url, headers={"Accept-Encoding": "gzip"})
    if dest.exists():
        req.add_header("If-Modified-Since", email.utils.formatdate(dest.stat().st_mtime, usegmt=True))
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            data = r.read()
            if r.headers.get("Content-Encoding", "").lower() == "gzip":
                data = gzip.decompress(data)
    except urllib.error.HTTPError as e:
        if e.code == 304 and dest.exists():
            # 탭 자동완성 캐시는 "인덱스보다 새로운가"로 낡음을 판단하니, 내용이 같으면 같이 갱신
            tokens_fresh = TOKENS_CACHE.exists() and TOKENS_CACHE.stat().st_mtime >= dest.stat().st_mtime
            os.utime(dest)  # 다음 24시간 동안은 다시 안 물어보게
            if tokens_fresh:
                os.utime(TOKENS_CACHE)
            return False
        raise
    tmp = dest.with_suffix(dest.suffix + ".part")
    tmp.write_bytes(data)
    tmp.rename(dest)
    return True


def load_homebrew_index(kind: str) -> list[dict]:
    """kind: 'cask' 또는 'formula'. 전체 목록을 로컬에 캐시해서 재사용."""
    INDEX_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    dest = INDEX_CACHE_DIR / f"{kind}.json"
    downloaded = False
    if not dest.exists() or (time.time() - dest.stat().st_mtime) > INDEX_MAX_AGE_SECONDS:
        try:
            downloaded = _download_json(HOMEBREW_BULK_API.format(kind=kind), dest)
        except Exception as e:  # 네트워크 문제 등 — 캐시가 있으면 그거라도 쓴다
            if not dest.exists():
                print(f"Homebrew {kind} 인덱스를 못 받았음: {e}", file=sys.stderr)
                return []
    data = json.loads(dest.read_text())
    if downloaded:
        # 탭 자동완성용 이름 목록도 지금 같이 갱신 — 안 그러면 다음 첫 탭에서 이 큰
        # JSON 파싱(기본 Python 3.9 기준 2초쯤)을 하느라 탭이 멈춘 것처럼 보임
        try:
            _completion_tokens()
        except Exception:
            pass
    return data


def _rank(query: str, *fields: str) -> int:
    """낮을수록 더 관련 있음. 매칭 안 되면 None 대신 큰 값을 돌려주는 쪽에서 걸러냄."""
    q = query.lower()
    for i, field in enumerate((f.lower() for f in fields if f)):
        if field == q:
            return i * 10 + 0
        if field.startswith(q):
            return i * 10 + 1
        if q in field:
            return i * 10 + 2
    # 공백/하이픈/언더스코어 무시하고 재시도 — "InputSourcePro"가 토큰
    # "input-source-pro"나 표시명 "Input Source Pro"를 못 찾는 걸 막음.
    # 정확 매칭보다는 못하지만(500 offset) 그래도 결과에 나오게.
    q_norm = re.sub(r"[^a-z0-9가-힣]", "", q)
    if q_norm:
        for i, field in enumerate((f.lower() for f in fields if f)):
            field_norm = re.sub(r"[^a-z0-9가-힣]", "", field)
            if field_norm == q_norm:
                return 500 + i * 10 + 0
            if field_norm.startswith(q_norm):
                return 500 + i * 10 + 1
            if q_norm in field_norm:
                return 500 + i * 10 + 2
    return 999


def search_homebrew(query: str) -> list[dict]:
    hits = []
    for kind, source in (("cask", "homebrew-cask"), ("formula", "homebrew-formula")):
        for entry in load_homebrew_index(kind):
            if kind == "cask":
                token = entry.get("token", "")
                display_name = entry.get("name")
                display_name = display_name[0] if isinstance(display_name, list) else (display_name or token)
                version = entry.get("version", "?")
            else:  # formula: name은 그냥 문자열이고 그 자체가 설치 식별자
                token = entry.get("name", "")
                display_name = token
                version = (entry.get("versions") or {}).get("stable", "?")
            desc = entry.get("desc", "")
            rank = _rank(query, token, display_name, desc)
            if rank < 999:
                # 대체판 상세(어느 버전인지/근거)는 search 테이블에 안 욱여넣고 jige info에서
                # 보게 함 — search는 ▼ 기호만 띄움(cmd_search가 처리), 버전 칸은 최신판 그대로.
                # (가벼운 조회만 함 — commit 내용을 실제로 열어보는 건 install 때)
                legacy = pick_legacy_for_this_mac(token) if kind == "cask" else None
                hits.append({
                    "name": token,
                    "version": version,
                    "desc": desc,
                    "source": source,
                    "kind": "jim" if kind == "cask" else "dogu",  # jim(짐)=데스크톱 앱, dogu(도구)=CLI
                    "rank": rank,
                    "legacy": legacy,
                })
    return hits


def search_macports(query: str) -> list[dict]:
    if current_os() != "macos":
        return []
    try:
        with urllib.request.urlopen(
            f"{MACPORTS_SEARCH_API}?search={urllib.parse.quote(query)}", timeout=10
        ) as r:
            data = json.load(r)
    except Exception as e:
        print(f"MacPorts 검색 실패(무시하고 계속): {e}", file=sys.stderr)
        return []
    hits = []
    for entry in data.get("results", [])[:30]:
        name = entry.get("name", "")
        desc = entry.get("description", "")
        rank = _rank(query, name, desc)
        hits.append({
            "name": name,
            "version": entry.get("version", "?"),
            "desc": desc,
            "source": "macports",
            "kind": "unknown",  # TODO: 포트파일 상세조회(app_dir 등)로 jim/dogu 구분 보강
            "rank": rank,
        })
    return hits


def search_mas(query: str, allow_mas: bool) -> list[dict]:
    # 옛 Homebrew-Cask가 별도 tap이었던 것처럼, mas는 설치돼 있어도 기본은 꺼짐.
    # 'jige config mas on'으로 켜거나 그때그때 --mas를 줘야 참여함.
    if not allow_mas or current_os() != "macos" or not shutil.which("mas"):
        return []
    try:
        params = urllib.parse.urlencode(
            {"media": "software", "entity": "macSoftware", "country": "kr", "term": query, "limit": 15}
        )
        with urllib.request.urlopen(f"{ITUNES_SEARCH_API}?{params}", timeout=10) as r:
            data = json.load(r)
    except Exception as e:
        print(f"Mac App Store 검색 실패(무시하고 계속): {e}", file=sys.stderr)
        return []
    hits = []
    for entry in data.get("results", []):
        name = entry.get("trackName", "")
        rank = _rank(query, name)
        hits.append({
            "name": name,
            "version": entry.get("version", "?"),
            "desc": entry.get("sellerName", ""),
            "source": "mas",
            "kind": "jim",  # mas는 전부 GUI 앱
            "rank": rank,
        })
    return hits


def search_local_recipes(query: str) -> list[dict]:
    hits = []
    if not LOCAL_RECIPES_DIR.exists():
        return hits
    for path in LOCAL_RECIPES_DIR.glob("*.json"):
        try:
            entry = json.loads(path.read_text())
        except json.JSONDecodeError:
            continue
        name = entry.get("name", path.stem)
        name = name[0] if isinstance(name, list) else name
        desc = entry.get("desc", "")
        rank = _rank(query, path.stem, name, desc)
        if rank < 999:
            hits.append({
                "name": path.stem,
                "version": entry.get("version", "?"),
                "desc": desc,
                "source": "local",
                "kind": entry.get("kind", "unknown"),  # 레시피에 직접 적어두면 됨: "jim"(데스크톱 앱) | "dogu"(CLI)
                "rank": rank,
            })
    return hits


def cmd_search(query: str, limit_per_source: int = 8, mas: bool = False) -> None:
    allow_mas = mas_enabled() or mas
    all_hits = (
        search_local_recipes(query) + search_macports(query)
        + search_mas(query, allow_mas) + search_homebrew(query) + search_user_repos(query)
    )
    if not all_hits:
        print(t("no_results", q=query))
        if not allow_mas:
            print("(Mac App Store는 안 뒤짐 — 포함하려면 'jige search ... --mas' 또는 'jige config mas on')")
        return

    by_source: dict[str, list[dict]] = {}
    for h in all_hits:
        by_source.setdefault(h["source"], []).append(h)

    rows = []
    for source, hits in by_source.items():
        hits.sort(key=lambda h: h["rank"])
        rows.extend(hits[:limit_per_source])
    rows.sort(key=lambda h: h["rank"])

    installed = load_state()

    # 종류는 jim/dogu 텍스트 대신 아이콘, 분류는 Homebrew/MacPorts 대신 실제 명령어 이름
    # (brew/port/mas) — 둘 다 짧아지는 김에 칸도 실제 값 기준으로 동적 계산.
    # ★(이미 설치됨)/▼+신뢰도(이 macOS용 대체판 — 상세는 jige info)는 분류-버전 사이의
    # 기본 간격(2칸) "안에" 끼워 넣음 — 마커가 있으면 그 폭만큼 앞 공백을 줄여서
    # (없으면 "  ", *면 " *") 총 폭은 그대로 2칸 유지 → 마커가 있든 없든 버전 숫자가
    # 항상 같은 자리에서 시작함(피드백: 전용 칸보다 이쪽이 "공간 절약"도 되고 더 자연스러움).
    # 설치 마커는 ★ 대신 그냥 "*" — 버전은 항상 숫자라 헷갈릴 일 없고, 폭이 항상 정확히
    # 1칸이라(★처럼 폭 모호하지 않음) 위 계산이 흔들림 없이 들어맞음.
    # desc엔 더 이상 아무것도 안 욱여넣음 — 폭 제약 없는 맨 끝 칸이라도 너무 길어지면
    # 읽기 힘들다는 피드백이 있었어서, 마커만 보고 필요하면 jige info로 넘어가게 함.
    GAP = 2
    icons = [kind_icon(h["kind"]) for h in rows]
    sources = [SOURCE_LABEL.get(h["source"], h["source"]) for h in rows]
    versions = [simplify_version_for_display(h["version"]) for h in rows]
    markers = []
    any_star = False
    any_legacy = False
    for h in rows:
        marker = ""
        if h["name"] in installed:
            marker += "*"
            any_star = True
        legacy = h.get("legacy")
        if legacy:
            marker += _sym("▼", "v") + trust_badge(legacy)
            any_legacy = True
        markers.append(marker)

    name_w = max(4, min(28, max(_display_width(h["name"]) for h in rows)))
    kind_w = max(_display_width(t("col_kind")), max(_display_width(i) for i in icons))
    source_w = max(_display_width(t("col_source")), max(_display_width(s) for s in sources))
    version_w = max(_display_width(t("col_version")), max(_display_width(v) for v in versions))
    # 마커가 기본 간격(2칸)보다 넓으면(예: ▼🆕) 어쩔 수 없이 그만큼 더 벌어짐
    gap_w = max((max(GAP, _display_width(m)) for m in markers), default=GAP)

    # desc 칸은 터미널 실제 가로폭에 맞춰서 자름 — 고정폭으로 하면 좁은 터미널에서 줄이
    # 꺾여서 다음 줄의 칸 정렬까지 같이 깨짐. 끝에서 2칸은 여유로 남겨둠(안전 마진).
    prefix_w = name_w + 2 + kind_w + 2 + source_w + gap_w + version_w + 2
    term_width = shutil.get_terminal_size(fallback=(100, 24)).columns
    desc_budget = max(20, term_width - prefix_w - 2)

    print(
        f"{_pad(t('col_name'), name_w)}  {_pad(t('col_kind'), kind_w)}  "
        f"{_pad(t('col_source'), source_w)}  {_pad(t('col_version'), version_w)}  {t('col_desc')}"
    )
    print("-" * min(term_width, prefix_w + 20))
    for h, icon, source, marker, version in zip(rows, icons, sources, markers, versions):
        name_field = _pad(h["name"], name_w)
        if h["name"] in installed:
            name_field = _bold(name_field)  # _pad()로 폭을 먼저 맞춘 뒤에 감싸야 함
        desc = _truncate_to_width(h["desc"] or "", desc_budget)
        # 마커 없으면 기본 간격(2칸) 그대로. 있으면 그 폭만큼 앞 공백을 줄이되, 마커가
        # 간격보다 넓어도(▼🆕 등) "brew▼🆕..."처럼 바로 붙어버리지 않게 최소 1칸은 남김.
        lead = max(1, GAP - _display_width(marker)) if marker else GAP
        gap = " " * lead + marker
        print(
            f"{name_field}  {_pad(icon, kind_w)}  {_pad(source, source_w)}"
            f"{gap}{_pad(version, version_w)}  {desc}"
        )

    print()
    print(t("install_hint"))
    legend = []
    if any_star:
        legend.append("* 이미 설치됨")
    if any_legacy:
        legend.append(f"{_sym('▼', 'v')} 이 macOS에 맞춘 대체판 — 자세히: jige info <이름>")
    if legend:
        print("  " + " / ".join(legend))


def fetch_mas_recipe(token: str, allow_mas: bool) -> dict | None:
    """App Store 앱 이름으로 정확히 일치하는 걸 찾아서 (mas install이 쓸 숫자 id 포함) 반환.
    mas가 꺼져있거나 설치 안 돼 있으면 조회 자체를 건너뜀."""
    if not allow_mas or current_os() != "macos" or not shutil.which("mas"):
        return None
    try:
        params = urllib.parse.urlencode(
            {"media": "software", "entity": "macSoftware", "country": "kr", "term": token, "limit": 25}
        )
        with urllib.request.urlopen(f"{ITUNES_SEARCH_API}?{params}", timeout=10) as r:
            data = json.load(r)
    except Exception:
        return None
    for entry in data.get("results", []):
        if entry.get("trackName", "").lower() == token.lower():
            return {
                "name": [entry["trackName"]],
                "version": entry.get("version", "?"),
                "homepage": entry.get("trackViewUrl"),
                "desc": entry.get("sellerName", ""),
                "_mas_id": entry["trackId"],
                "_min_macos": entry.get("minimumOsVersion"),
            }
    return None


# ---------------------------------------------------------------------------
# 사용자 레포지토리: 사용자가 직접 등록하는 외부/자체 저장소(집 NAS, 회사 서버 등).
# jige 공식 레포지토리(recipes/)와 완전히 분리 — 저장소 루트의 jige-catalog.json
# 하나로 어떤 토큰/버전/파일이 있는지 알아냄. 인증은 jige가 저장/관리하지 않음:
# curl -n으로 ~/.netrc를 그대로 쓰고(Basic), Bearer 토큰은 등록할 때 적어둔
# "환경변수 이름"으로 그때그때 읽음 — jige 자신의 설정 파일엔 비밀값이 전혀 안 남음.
# ---------------------------------------------------------------------------

USER_REPO_CATALOG_NAME = "jige-catalog.json"


def load_user_repos() -> list[dict]:
    return load_config().get("user_repos", [])


def save_user_repos(repos: list[dict]) -> None:
    config = load_config()
    config["user_repos"] = repos
    save_config(config)


def _parse_repo_url(url: str) -> tuple[str, str]:
    """(프로토콜, 나머지) 반환. file://, http(s)://, ssh:// 지원. 스킴이 없으면 로컬 경로로
    취급(SMB/WebDAV를 Finder로 이미 마운트해서 /Volumes/... 로 쓰는 경우가 이쪽)."""
    m = re.match(r"^([a-z]+)://(.*)$", url)
    if not m:
        return "file", url
    scheme, rest = m.group(1), m.group(2)
    if scheme not in ("file", "http", "https", "ssh"):
        sys.exit(f"지원 안 하는 프로토콜: {scheme}:// (가능: file, http, https, ssh — 또는 스킴 없이 로컬 경로)")
    return scheme, rest


def _repo_curl(url: str, repo: dict, dest: Path | None) -> bytes | None:
    cmd = ["curl", "-fsSL", "-n"]  # -n: ~/.netrc 있으면 자동 사용(Basic Auth), 없어도 무해
    if repo.get("bearer_env"):
        token = os.environ.get(repo["bearer_env"])
        if not token:
            sys.exit(f"환경변수 {repo['bearer_env']}가 비어있음 (사용자 레포 '{repo['name']}' 인증용)")
        cmd += ["--oauth2-bearer", token]
    if dest:
        subprocess.run(cmd + ["-o", str(dest), url], check=True)
        return None
    return subprocess.run(cmd + [url], check=True, capture_output=True).stdout


def _repo_ssh_target(repo: dict) -> tuple[str, str]:
    """ssh://user@host/path -> (user@host, /path) — ssh/scp 명령에 바로 쓸 수 있는 형태."""
    _, rest = _parse_repo_url(repo["url"])
    host, _, path = rest.partition("/")
    return host, "/" + path


def repo_read_text(repo: dict, relpath: str) -> str:
    scheme, rest = _parse_repo_url(repo["url"])
    if scheme == "file":
        return (Path(rest).expanduser() / relpath).read_text()
    if scheme in ("http", "https"):
        return _repo_curl(f"{repo['url'].rstrip('/')}/{relpath}", repo, None).decode("utf-8")
    host, path = _repo_ssh_target(repo)
    out = subprocess.run(["ssh", host, "cat", f"{path.rstrip('/')}/{relpath}"],
                          check=True, capture_output=True, text=True)
    return out.stdout


def repo_fetch_file(repo: dict, relpath: str, dest: Path) -> None:
    scheme, rest = _parse_repo_url(repo["url"])
    if scheme == "file":
        shutil.copyfile(Path(rest).expanduser() / relpath, dest)
    elif scheme in ("http", "https"):
        _repo_curl(f"{repo['url'].rstrip('/')}/{relpath}", repo, dest)
    else:
        host, path = _repo_ssh_target(repo)
        subprocess.run(["scp", "-q", f"{host}:{path.rstrip('/')}/{relpath}", str(dest)], check=True)


def fetch_user_repo_catalog(repo: dict) -> dict | None:
    """실패(연결 안 됨 등)하면 None — search_macports처럼 조용히 건너뜀(경고만 출력)."""
    try:
        return json.loads(repo_read_text(repo, USER_REPO_CATALOG_NAME))
    except Exception as e:
        print(f"사용자 레포 '{repo['name']}' 연결 실패(건너뜀): {e}", file=sys.stderr)
        return None


def _version_sort_key(v: str) -> tuple:
    """'3.10'이 '3.9'보다 작게 비교되는 문자열정렬 버그(macos_in_range에서 겪었던
    자릿수 패딩 버그와 같은 종류)를 피하려고 점/하이픈으로 쪼개서 숫자는 숫자로 비교."""
    parts = re.split(r"[.\-]", v)
    return tuple((0, int(p)) if p.isdigit() else (1, p) for p in parts)


def resolve_user_repo_file(entry: dict, cpu: str) -> dict | None:
    """카탈로그 entry의 versions.*.files[]에서 이 머신(아키텍처/플랫폼/macOS 버전)에 맞는
    것 중 가장 최신 버전을 고름. platform/arch/min_os는 전부 생략 가능 — 생략한 항목은
    이 머신에서 지원하는 것으로 간주(아는 것만 적으면 됨). 맞는 파일이 하나도 없으면 None
    (예: 카탈로그에 윈도우 빌드만 있는데 이 머신은 Mac인 경우)."""
    candidates = []
    for version, vdata in (entry.get("versions") or {}).items():
        for f in vdata.get("files", []):
            if f.get("platform") and f["platform"] != "macos":
                continue
            if f.get("arch") and f["arch"] != cpu:
                continue
            if f.get("min_os") and not meets_min_macos(f["min_os"]):
                continue
            candidates.append((version, f))
    if not candidates:
        return None
    version, f = max(candidates, key=lambda vf: _version_sort_key(vf[0]))
    return {"version": version, "file": f}


def search_user_repos(query: str) -> list[dict]:
    hits = []
    cpu = arch()
    for repo in load_user_repos():
        catalog = fetch_user_repo_catalog(repo)
        if not catalog:
            continue
        for token, entry in catalog.items():
            name = entry.get("name", token)
            name = name[0] if isinstance(name, list) else name
            desc = entry.get("desc", "")
            rank = _rank(query, token, name, desc)
            if rank >= 999:
                continue
            resolved = resolve_user_repo_file(entry, cpu)
            hits.append({
                "name": token,
                "version": resolved["version"] if resolved else "?",
                "desc": desc,
                "source": f"user:{repo['name']}",
                "kind": entry.get("kind", "unknown"),
                "rank": rank,
            })
    return hits


def find_exact_token_hits(token: str) -> dict[str, dict]:
    """토큰과 정확히 이름이 같은 항목을 Homebrew cask/formula, MacPorts, 등록된 사용자
    레포지토리에서 찾음. search의 _rank()는 느슨한 부분일치지만 여긴 완전 일치만 봄 —
    install/info에서 토큰이 여러 곳에 걸쳐 서로 다른 소프트웨어일 수 있을 때(예: mole =
    brew formula는 Mac 클리너, MacPorts port는 ssh 터널 도구) 자동으로 아무거나 고르지
    않기 위한 용도. 값은 전부 {"entry": ...} 형태로 통일함(사용자 레포 쪽은 version/
    file/repo도 같이 들어있음)."""
    tl = token.lower()
    hits: dict[str, dict] = {}

    for entry in load_homebrew_index("cask"):
        if entry.get("token", "").lower() == tl:
            hits["cask"] = {"entry": entry}
            break

    for entry in load_homebrew_index("formula"):
        if entry.get("name", "").lower() == tl:
            hits["formula"] = {"entry": entry}
            break

    if current_os() == "macos":
        try:
            with urllib.request.urlopen(
                f"{MACPORTS_SEARCH_API}?search={urllib.parse.quote(token)}", timeout=10
            ) as r:
                data = json.load(r)
            for entry in data.get("results", []):
                if entry.get("name", "").lower() == tl:
                    hits["port"] = {"entry": entry}
                    break
        except Exception:
            pass  # MacPorts 조회 실패는 무시 — brew 쪽 결과만으로도 판단 가능

    cpu = arch()
    for repo in load_user_repos():
        catalog = fetch_user_repo_catalog(repo)
        if not catalog or token not in catalog:
            continue
        entry = catalog[token]
        resolved = resolve_user_repo_file(entry, cpu)
        if not resolved:
            continue  # 이 머신에 맞는 파일이 없음 — 못 찾은 것과 같게 취급
        hits[f"user_repo:{repo['name']}"] = {"entry": entry, "repo": repo, **resolved}

    return hits


SOURCE_KIND_LABEL = {"cask": "brew (jim, GUI)", "formula": "brew (dogu, CLI)", "port": "port (MacPorts)"}


def _hit_label(kind: str) -> str:
    return f"user-repo:{kind.split(':', 1)[1]}" if kind.startswith("user_repo:") else SOURCE_KIND_LABEL[kind]


def _hit_version(kind: str, hit: dict) -> str:
    if kind.startswith("user_repo:"):
        return hit["version"]
    entry = hit["entry"]
    return (entry.get("versions") or {}).get("stable", "?") if kind == "formula" else entry.get("version", "?")


def disambiguate_source(token: str, repo: str | None = None) -> dict:
    """토큰이 brew(cask/formula)/MacPorts/사용자 레포지토리에 동시에 정확히 일치하면
    --repo 없인 진행하지 않음 — 서로 다른 프로그램일 위험(mole 사례)이 있어서 자동
    선택 금지. 단, 사용자 레포지토리끼리만 겹치는 건 등록 순서(user_repo_order)로
    조용히 해결함 — 그건 사용자가 자기가 등록한 레포들 사이의 일이라 본인 책임 범위.
    brew/port ↔ 사용자 레포처럼 jige가 통제 못 하는 서로 다른 생태계끼리 겹치는 건
    순서와 무관하게 여전히 막음.
    반환: {"kind": ..., "entry": {...}, [user_repo면 "version"/"file"/"repo"도]}
    또는 어디에도 정확히 일치하는 게 없으면 빈 dict(로컬 recipes/MAS 등 기존 경로로
    계속 찾게 둠 — 이 경우는 안전함)."""
    hits = find_exact_token_hits(token)
    if not hits:
        return {}

    if repo == "brew":
        hits = {k: v for k, v in hits.items() if k in ("cask", "formula")}
    elif repo:
        key = repo if repo == "port" else f"user_repo:{repo}"
        hits = {k: v for k, v in hits.items() if k == key}

    if repo and not hits:
        sys.exit(f"'{token}'는 '{repo}'에 정확히 일치하는 게 없습니다.")

    if not repo:
        non_user = {k: v for k, v in hits.items() if not k.startswith("user_repo:")}
        user_hits = {k: v for k, v in hits.items() if k.startswith("user_repo:")}
        if not non_user and len(user_hits) > 1:
            order = load_config().get("user_repo_order", [])
            best = min(user_hits, key=lambda k: (order.index(k.split(":", 1)[1])
                                                  if k.split(":", 1)[1] in order else len(order)))
            hits = {best: user_hits[best]}

    if len(hits) > 1:
        print(f"'{token}'와 정확히 이름이 같은 게 여러 레포에 있습니다 — 서로 다른 프로그램일 수 있어서 자동으로 고르지 않습니다:")
        for kind, hit in hits.items():
            desc = hit["entry"].get("desc") or hit["entry"].get("description") or ""
            print(f"  [{_hit_label(kind)}] v{_hit_version(kind, hit)} — {desc}")
        first_kind = next(iter(hits))
        example = (first_kind.split(":", 1)[1] if first_kind.startswith("user_repo:")
                   else "port" if first_kind == "port" else "brew")
        sys.exit(f"-> --repo <이름>으로 어느 쪽인지 지정하세요 (예: jige install {token} --repo {example})")

    kind, hit = next(iter(hits.items()))
    return {"kind": kind, **hit}


def fetch_recipe(token: str, allow_mas: bool = False) -> tuple[dict, str]:
    """(레시피, 출처설명) 반환. 로컬 recipes/ -> Homebrew-Cask -> Mac App Store 순으로 찾음."""
    local_path = LOCAL_RECIPES_DIR / f"{token}.json"
    if local_path.exists():
        return json.loads(local_path.read_text()), f"로컬 레시피 ({local_path})"

    url = HOMEBREW_CASK_API.format(token=urllib.parse.quote(token, safe=""))
    try:
        with urllib.request.urlopen(url, timeout=15) as r:
            return json.load(r), "Homebrew-Cask 공개 레시피"
    except urllib.error.HTTPError as e:
        if e.code != 404:
            raise

    mas_recipe = fetch_mas_recipe(token, allow_mas)
    if mas_recipe:
        return mas_recipe, "Mac App Store"

    hint = (
        "recipes/{0}.json 을 같은 스키마로 직접 추가하면 설치할 수 있습니다."
        if allow_mas or mas_enabled() else
        "Mac App Store는 안 뒤져봤습니다 — 'jige install {0} --mas' 또는 'jige config mas on'으로 켜보세요."
    ).format(token)
    sys.exit(f"'{token}'는 Homebrew-Cask·로컬 recipes/ 어디에도 없습니다.\n-> {hint}")


def pick_url_sha(recipe: dict, cpu: str, codename: str) -> tuple[str, str]:
    if cpu == "arm64":
        return recipe["url"], recipe["sha256"]
    # Homebrew-Cask의 variations는 기본값과 "다른 필드만" 적어두는 희소(sparse) override라서
    # (예: vagrant는 url만 arch별로 다르고 sha256은 공통이라 variation에 url만 있음) 없는
    # 필드는 반드시 레시피 기본값으로 메꿔야 함 — 통째로 가정하면 KeyError 남(실제로 겪음).
    v = (recipe.get("variations") or {}).get(codename) or {}
    return v.get("url", recipe["url"]), v.get("sha256", recipe["sha256"])


CASK_RB_RAW_URL_RE = re.compile(
    r"^https://raw\.githubusercontent\.com/Homebrew/homebrew-cask/([0-9a-f]+)/(Casks/.+\.rb)$"
)


def parse_cask_rb(text: str) -> dict:
    """brew가 직접 읽는 cask .rb 파일을 정규식으로 최소한만 파싱.
    jige 자체 recipe 스키마로 못 바꾸는 복잡한 on_arch_conditional/if 블록 등은
    건드리지 않고 그냥 None으로 둠 — 모르면서 지어내지 않는 게 핵심."""
    out: dict = {
        "version": None, "arch_map": None, "sha256": None,
        "url_template": None, "name": None, "desc": None, "homepage": None,
        "app": None, "pkg": None, "depends_on_macos": None,
    }
    m = re.search(r'^\s*version\s+"([^"]+)"', text, re.M)
    if m:
        out["version"] = m.group(1)
    m = re.search(r'^\s*arch\s+arm:\s*"([^"]+)"\s*,\s*intel:\s*"([^"]+)"', text, re.M)
    if m:
        out["arch_map"] = {"arm": m.group(1), "intel": m.group(2)}
    m = re.search(r'^\s*sha256\s+"([0-9a-f]{64})"', text, re.M)
    if m:
        out["sha256"] = {"arm": m.group(1), "intel": m.group(1)}
    else:
        m = re.search(
            r'^\s*sha256\s+arm:\s*"([0-9a-f]{64})"\s*,?\s*\n?\s*intel:\s*"([0-9a-f]{64})"',
            text, re.M,
        )
        if m:
            out["sha256"] = {"arm": m.group(1), "intel": m.group(2)}
    m = re.search(r'^\s*url\s+"([^"]+)"', text, re.M)
    if m:
        out["url_template"] = m.group(1)
    m = re.search(r'^\s*name\s+"([^"]+)"', text, re.M)
    if m:
        out["name"] = m.group(1)
    m = re.search(r'^\s*desc\s+"([^"]+)"', text, re.M)
    if m:
        out["desc"] = m.group(1)
    m = re.search(r'^\s*homepage\s+"([^"]+)"', text, re.M)
    if m:
        out["homepage"] = m.group(1)
    m = re.search(r'^\s*app\s+"([^"]+\.app)"', text, re.M)
    if m:
        out["app"] = m.group(1)
    m = re.search(r'^\s*pkg\s+"([^"]+\.pkg)"', text, re.M)
    if m:
        out["pkg"] = m.group(1)
        # choices는 선택적 — 못 찾으면 pkg 자체의 기본 선택값으로 설치(자동 선택 보정 없음)
    # "depends_on macos: ..." (버전 비교형)만 잡음 — 플랫폼 마커인 "depends_on :macos"는 매치 안 됨
    m = re.search(r'^\s*depends_on\s+macos:\s*(.+)$', text, re.M)
    if m:
        out["depends_on_macos"] = m.group(1).strip()
    return out


_CODENAME_TO_MAJOR = {name: major for major, name in
                       ((k.split(".")[0], v) for k, v in MACOS_CODENAME.items())}


def depends_on_macos_floor(expr: str) -> str | None:
    """'">= :monterey"'/'":monterey"'/'">= 13"' 같은 cask DSL 표현을 jige의
    depends_on.macos.>= 에 쓰는 숫자 문자열로 바꿈. 해석 못 하면 None."""
    m = re.search(r':(\w+)', expr)
    if m and m.group(1) in _CODENAME_TO_MAJOR:
        return _CODENAME_TO_MAJOR[m.group(1)]
    m = re.search(r'(\d+(?:\.\d+)?)', expr)
    return m.group(1) if m else None


def resolve_cask_rb_url(template: str, version: str, arch_literal: str) -> str | None:
    """#{version}, #{version.csv.first}, #{version.csv.second}, #{arch} 정도의
    흔한 패턴만 치환 — 그 외 변수가 남아있으면 None(모르는 템플릿은 포기)."""
    csv_parts = version.split(",")
    repl = {
        "version.csv.first": csv_parts[0],
        "version.csv.second": csv_parts[1] if len(csv_parts) > 1 else "",
        "version": version,
        "arch": arch_literal,
    }
    out = template
    for key, val in repl.items():
        out = out.replace("#{" + key + "}", val)
    return None if "#{" in out else out


def fetch_recipe_from_cask_rb(url: str, cpu: str) -> dict:
    """brew가 하는 것처럼 — Homebrew-Cask의 특정 커밋(과거 버전 포함) raw .rb URL을
    직접 읽어서 jige recipe 스키마로 바꿈. 이 머신의 cpu에 맞춰 바로 url/sha256을
    확정해서 돌려줌(여러 macOS 코드네임별 variations는 필요 없음 — 지금 이 기기용)."""
    with urllib.request.urlopen(url, timeout=20) as r:
        text = r.read().decode("utf-8", errors="replace")

    parsed = parse_cask_rb(text)
    if not parsed["version"]:
        sys.exit(f"'{url}'에서 version을 못 읽음 — 정규식으로 파싱 가능한 단순한 cask 파일만 지원함")
    if not parsed["arch_map"] or not parsed["sha256"] or not parsed["url_template"]:
        sys.exit(f"'{url}'의 arch/sha256/url 선언이 지금 파서로 못 읽는 형태임 — 수동 설치 필요")

    which = "arm" if cpu == "arm64" else "intel"
    arch_literal = parsed["arch_map"][which]
    resolved_url = resolve_cask_rb_url(parsed["url_template"], parsed["version"], arch_literal)
    if not resolved_url:
        sys.exit(f"url 템플릿을 못 풂: {parsed['url_template']!r} (모르는 변수 포함)")
    sha = parsed["sha256"][which]

    artifacts = []
    if parsed["app"]:
        artifacts.append({"app": [parsed["app"]]})
    elif parsed["pkg"]:
        artifacts.append({"pkg": [parsed["pkg"]]})  # choices는 이 파서로 안 뽑음 — pkg 기본값으로 설치됨

    depends_on = {}
    if parsed["depends_on_macos"]:
        floor = depends_on_macos_floor(parsed["depends_on_macos"])
        if floor:
            depends_on = {"macos": {">=": [floor]}}

    return {
        "name": [parsed["name"] or parsed["desc"] or parsed["version"]],
        "version": parsed["version"],
        "url": resolved_url,
        "sha256": sha,
        "variations": {},
        "artifacts": artifacts,
        "homepage": parsed["homepage"],
        "desc": parsed["desc"],
        "depends_on": depends_on,
    }


def sha256_of(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def sha1_of(path: Path) -> str:
    """MacPorts의 .pkg 릴리스는 sha256이 아니라 sha1만 제공해서 따로 둠(소스 tar만 sha256 있음)."""
    h = hashlib.sha1()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def download(url: str, dest: Path) -> None:
    if dest.exists():
        print(f"캐시 사용: {dest.name}")
        return
    print(f"다운로드: {url}")
    tmp = dest.with_suffix(dest.suffix + ".part")
    urllib.request.urlretrieve(url, tmp)
    tmp.rename(dest)


# ===========================================================================
# 설치 = ① 포장 풀기 + ② 아티팩트 설치, 두 단계로 분리 — Homebrew와 같은 구조.
#   ① Library/Homebrew/unpack_strategy/  : 받은 파일을 "내용"으로 판별해서 임시 폴더에 풂
#   ② Library/Homebrew/cask/artifact/    : 풀린 폴더에서 레시피의 app/pkg/installer/suite 실행
# 포장 형태(dmg/zip/tar/pkg/…)와 설치 방식(app/pkg/…)이 서로 독립이라 어떤 조합이든 동작함.
# (그 전엔 "DMG면 이렇게, .pkg면 저렇게"를 경우마다 덧붙여서 zip 앱·.pkg 단독 등에서 깨졌음)
# 규칙은 Homebrew(BSD-2-Clause, Copyright Homebrew contributors) 코드를 읽고 Python으로 다시 구현.
