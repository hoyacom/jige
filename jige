SUPPORTED_ARTIFACTS = {"app", "suite", "pkg", "installer"}
# 설치 단계가 아닌 키(제거·정리용) — "미지원"으로 세지 않음
NON_INSTALL_KEYS = {"uninstall", "zap", "uninstall_preflight_steps", "uninstall_postflight_steps"}
SKIP_LABELS = {
    "binary": "CLI 명령 연결", "manpage": "man 페이지", "bash_completion": "bash 자동완성",
    "zsh_completion": "zsh 자동완성", "fish_completion": "fish 자동완성",
    "generate_completions_from_executable": "자동완성 생성", "command_wrapper": "CLI 명령 연결",
    "font": "폰트", "qlplugin": "Quick Look 플러그인", "screen_saver": "화면 보호기",
    "prefpane": "환경설정 패널", "service": "서비스", "input_method": "입력기",
    "keyboard_layout": "키보드 배치", "dictionary": "사전", "colorpicker": "색상 선택기",
    "vst_plugin": "VST 플러그인", "vst3_plugin": "VST3 플러그인", "audio_unit_plugin": "오디오 유닛",
    "artifact": "임의 파일 배치", "app_image": "AppImage", "generated_script": "생성 스크립트",
    "preflight_steps": "설치 전 단계", "postflight_steps": "설치 후 단계",
}


def _expand_cask_path(raw: str, token: str, version: str, staged: Path) -> Path:
    """레시피 경로 속 변수 풀기: $HOMEBREW_PREFIX/Caskroom/<token>/<version> = 풀어둔 폴더,
    $APPDIR = 앱 폴더, ~ = 홈. 레시피의 target은 brew가 /Applications로 계산해 둔 값이라
    JIGE_APPDIR을 바꾼 경우 그 앞부분만 갈아끼움."""
    s = raw.replace(f"$HOMEBREW_PREFIX/Caskroom/{token}/{version}", str(staged))
    s = s.replace("$APPDIR", str(APPDIR))
    if s == "/Applications" or s.startswith("/Applications/"):
        s = str(APPDIR) + s[len("/Applications"):]
    return Path(os.path.expanduser(s))


def plan_artifacts(recipe: dict) -> tuple[list[tuple[str, list, dict]], list[str]]:
    """레시피 artifacts -> (설치할 것 [(종류, 값, 원본 dict)], 건너뛸 것 설명 목록)."""
    todo, skipped = [], []
    for art in recipe.get("artifacts", []):
        for key, value in art.items():
            if key == "target" or key in NON_INSTALL_KEYS:
                continue
            if key in SUPPORTED_ARTIFACTS:
                todo.append((key, value, art))
            else:
                label = SKIP_LABELS.get(key, key)
                name = value[0] if isinstance(value, list) and value and isinstance(value[0], str) else ""
                skipped.append(f"{label}{f' ({name})' if name else ''}")
    return todo, skipped


def _place(src: Path, target: Path) -> None:
    """풀어둔 폴더의 앱/폴더를 설치 위치로 — 이미 있으면 기존 것은 휴지통으로."""
    if not src.exists():
        have = ", ".join(p.name for p in src.parent.iterdir()) if src.parent.is_dir() else "?"
        raise UnsupportedInstall(f"풀린 파일 안에서 '{src.name}'을 못 찾음 (있는 것: {have})")
    if target.exists() or target.is_symlink():
        print(f"기존 {target} -> 휴지통({move_to_trash(target)})")
    target.parent.mkdir(parents=True, exist_ok=True)
    print(f"{src.name} -> {target}")
    if subprocess.run(["ditto", str(src), str(target)]).returncode != 0:
        print("(권한이 없어서 sudo로 다시 시도)")
        subprocess.run(["sudo", "ditto", str(src), str(target)], check=True)


def install_artifacts(token: str, recipe: dict, staged: Path) -> dict:
    """반환: 설치 결과 {"apps": [설치된 경로], "pkg": bool, "manual": 경로|None}"""
    version = str(recipe.get("version", ""))
    todo, skipped = plan_artifacts(recipe)
    if not todo:
        raise UnsupportedInstall(
            "jige가 아직 지원하지 않는 설치 방식만 있음: " + ", ".join(skipped or ["(없음)"]))
    result: dict = {"apps": [], "pkg": False, "manual": None}
    for key, value, art in todo:
        if key in ("app", "suite"):
            # 원본도 변수를 품을 수 있음 — 예: suite가 "$HOMEBREW_PREFIX/Caskroom/<token>/<ver>"
            # (= 풀어둔 폴더 전체)를 통째로 앱 폴더로 옮기는 레시피(magicavoxel 등)
            src = (_expand_cask_path(value[0], token, version, staged) if "$" in value[0]
                   else staged / value[0])
            target_raw = art.get("target") or next(
                (v["target"] for v in value[1:] if isinstance(v, dict) and "target" in v), None)
            target = (_expand_cask_path(target_raw, token, version, staged) if target_raw
                      else APPDIR / Path(value[0]).name)
            if not target.is_absolute():
                target = APPDIR / target
            _place(src, target)
            result["apps"].append(str(target))
        elif key == "pkg":
            pkg_path = staged / value[0]
            if not pkg_path.exists():
                raise UnsupportedInstall(f"풀린 파일 안에서 {value[0]}을 못 찾음")
            run_pkg_installer(pkg_path, value)
            result["pkg"] = True
        elif key == "installer":
            for spec in value:
                if "manual" in spec:
                    # 설치 프로그램을 사람이 직접 눌러야 하는 앱 — 풀어둔 걸 남겨두고 열어줌
                    keep = CACHE_DIR.parent / "staged" / token
                    if keep.exists():
                        shutil.rmtree(keep)
                    shutil.copytree(staged, keep, symlinks=True)
                    path = keep / spec["manual"]
                    print(f"이 앱은 설치 프로그램을 직접 실행해야 합니다 — 여는 중: {path}")
                    subprocess.run(["open", str(path)])
                    result["manual"] = str(path)
                elif "script" in spec:
                    s = spec["script"] if isinstance(spec["script"], dict) else {"executable": spec["script"]}
                    exe = _expand_cask_path(s["executable"], token, version, staged)
                    if not exe.is_absolute():
                        exe = staged / s["executable"]
                    cmd = [str(exe), *[str(a) for a in s.get("args", [])]]
                    if s.get("sudo"):
                        print("관리자 권한(sudo)이 필요합니다 — 비밀번호를 입력하세요.")
                        cmd = ["sudo", *cmd]
                    print(f"설치 스크립트 실행: {exe.name}")
                    if subprocess.run(cmd).returncode != 0 and s.get("must_succeed", True):
                        sys.exit("설치 스크립트가 실패함 — 위 메시지를 확인하세요.")
    for note in skipped:
        print(f"(건너뜀: {note} — jige가 아직 처리 안 하는 단계)")
    return result


def run_pkg_installer(pkg_path: Path, pkg_artifact: list) -> None:
    """.pkg 파일 하나를 macOS installer로 설치 (brew cask/artifact/pkg.rb와 같이 choices 지원)."""
    choices = next(
        (extra["choices"] for extra in pkg_artifact[1:]
         if isinstance(extra, dict) and "choices" in extra),
        None,
    )
    choices_plist: Path | None = None
    cmd = ["sudo", "installer", "-pkg", str(pkg_path), "-target", "/"]
    if choices:
        fd, tmp_name = tempfile.mkstemp(suffix=".plist")
        os.close(fd)
        choices_plist = Path(tmp_name)
        with open(choices_plist, "wb") as f:
            plistlib.dump(choices, f)
        cmd += ["-applyChoiceChangesXML", str(choices_plist)]

    print("관리자 권한(sudo)이 필요합니다 — 비밀번호를 입력하세요.")
    try:
        result = subprocess.run(cmd)
    finally:
        if choices_plist:
            choices_plist.unlink(missing_ok=True)
    if result.returncode != 0:
        sys.exit(f"installer가 실패함(종료 코드 {result.returncode}) — 위 메시지를 확인하세요.")


def installed_version(app_path: Path) -> str | None:
    plist_path = app_path / "Contents" / "Info.plist"
    if not plist_path.exists():
        return None
    with open(plist_path, "rb") as f:
        return plistlib.load(f).get("CFBundleShortVersionString")


