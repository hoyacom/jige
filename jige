APPDIR = Path(os.environ.get("JIGE_APPDIR", "/Applications"))  # brew --appdir 와 같은 역할

# DMG에서 꺼내 오지 않을 것들 (brew unpack_strategy/dmg.rb의 DMG_METADATA와 같음)
DMG_METADATA = {
    ".background", ".com.apple.timemachine.donotpresent", ".com.apple.timemachine.supported",
    ".DocumentRevisions-V100", ".DS_Store", ".fseventsd", ".MobileBackups", ".Spotlight-V100",
    ".TemporaryItems", ".Trashes", ".VolumeIcon.icns", ".HFS+ Private Directory Data\r",
    ".journal", ".journal_info_block",
}

# 지금은 못 푸는 포장 — macOS 기본 도구로 안 되거나(별도 프로그램 필요) 거의 안 쓰임
UNSUPPORTED_CONTAINERS = {"7z": "7-Zip", "rar": "RAR", "sit": "StuffIt", "cab": "CAB"}


class UnsupportedInstall(Exception):
    """레시피는 정상인데 jige가 아직 처리 못 하는 형태 — traceback 대신 이유를 보여주려고."""


def detect_container(path: Path) -> str:
    """받은 파일 종류를 앞부분 바이트로 판별 (brew UnpackStrategy.detect와 같은 순서·기준).
    반환: 'tar' | 'dmg' | 'zip' | 'xar' | 'uncompressed' | UNSUPPORTED_CONTAINERS의 키"""
    if path.is_dir():
        return "directory"
    with open(path, "rb") as f:
        head = f.read(512)
    if head[257:262] == b"ustar":
        return "tar"
    compressed = (head.startswith(b"\x1f\x8b") or head.startswith(b"\xfd7zXZ\x00")
                  or head.startswith(b"BZh") or head.startswith(b"\x28\xb5\x2f\xfd"))
    if compressed and subprocess.run(["tar", "-tf", str(path)], capture_output=True).returncode == 0:
        return "tar"  # tar.gz / tar.xz / tar.bz2 / tar.zst — bsdtar가 압축 종류를 알아서 처리
    if head.startswith(b"PK\x03\x04") or head.startswith(b"PK\x05\x06"):
        return "zip"
    if head.startswith(b"xar!"):
        return "xar"  # flat .pkg도 xar
    if head.startswith(b"7z\xbc\xaf\x27\x1c"):
        return "7z"
    if head.startswith(b"Rar!"):
        return "rar"
    if head.startswith(b"SIT!") or head[:8] == b"StuffIt ":
        return "sit"
    if head.startswith(b"MSCF"):
        return "cab"
    if subprocess.run(["hdiutil", "imageinfo", "-format", str(path)],
                      capture_output=True).returncode == 0:
        return "dmg"
    return "uncompressed"  # 실행파일·폰트·앱 바이너리 등 포장 안 된 파일 그 자체


def _copy_tree_item(src: Path, dest_dir: Path) -> None:
    subprocess.run(["ditto", str(src), str(dest_dir / src.name)], check=True)


def _extract_dmg(path: Path, to: Path) -> None:
    mount_point = attach_dmg(path, f"stage-{os.getpid()}")
    try:
        for child in mount_point.iterdir():
            if child.name in DMG_METADATA:
                continue
            # DMG에 흔히 있는 "/Applications로 가는 바로가기"는 꺼내지 않음 (brew도 같음)
            if child.is_symlink() and os.readlink(child).startswith("/"):
                continue
            _copy_tree_item(child, to)
    finally:
        detach_dmg(mount_point)


def extract_once(path: Path, kind: str, to: Path, basename: str) -> None:
    to.mkdir(parents=True, exist_ok=True)
    if kind == "dmg":
        _extract_dmg(path, to)
    elif kind == "zip":
        # ditto는 Apple 기본 도구 — zip 안의 확장 속성·__MACOSX 리소스 포크까지 제대로 처리
        subprocess.run(["ditto", "-x", "-k", str(path), str(to)], check=True)
    elif kind == "tar":
        subprocess.run(["tar", "-xf", str(path), "-C", str(to), "--no-same-owner"], check=True)
    elif kind == "directory":
        _copy_tree_item(path, to)
    else:  # uncompressed / xar(.pkg) — 풀지 않고 원래 파일 이름 그대로 둠
        subprocess.run(["ditto", str(path), str(to / basename)], check=True)


def extract_nestedly(path: Path, to: Path, basename: str, keep_xar: bool) -> None:
    """brew extract_nestedly: 풀었는데 결과가 파일 하나뿐이면(예: zip 안에 dmg) 그것도 이어서 풂."""
    kind = detect_container(path)
    if kind in UNSUPPORTED_CONTAINERS:
        raise UnsupportedInstall(f"{UNSUPPORTED_CONTAINERS[kind]} 압축 파일은 아직 풀 수 없음")
    if kind == "xar" and not keep_xar:
        kind = "xar-extract"
    if kind in ("uncompressed", "xar", "directory"):
        extract_once(path, kind, to, basename)
        return
    if kind == "xar-extract":
        to.mkdir(parents=True, exist_ok=True)
        subprocess.run(["xar", "-x", "-f", str(path), "-C", str(to)], check=True)
        return
    with tempfile.TemporaryDirectory(prefix="jige-unpack-") as tmp:
        tmp_path = Path(tmp)
        extract_once(path, kind, tmp_path, basename)
        children = list(tmp_path.iterdir())
        if len(children) == 1 and children[0].is_file() and not children[0].is_symlink():
            extract_nestedly(children[0], to, children[0].name, keep_xar)
            return
        to.mkdir(parents=True, exist_ok=True)
        for child in children:
            shutil.move(str(child), str(to / child.name))


def stage_download(download_path: Path, url: str, recipe: dict, staged: Path) -> None:
    """① 포장 풀기 — brew Cask::Download#extract_primary_container 와 같은 흐름.
    container.type이 naked/nounzip이면 풀지 않음, container.nested면 한 겹 더 들어가서 풂."""
    basename = urllib.parse.unquote(url.rsplit("/", 1)[-1].split("?")[0]) or download_path.name
    container = recipe.get("container") or {}
    # .pkg 아티팩트가 있으면 xar(.pkg)는 풀지 말고 파일 그대로 둬야 installer에 넘길 수 있음
    keep_xar = any("pkg" in a for a in recipe.get("artifacts", []))
    if container.get("type") in ("naked", "nounzip"):
        extract_once(download_path, "uncompressed", staged, basename)
    elif container.get("nested"):
        with tempfile.TemporaryDirectory(prefix="jige-outer-") as tmp:
            outer = Path(tmp)
            extract_once(download_path, detect_container(download_path), outer, basename)
            nested = outer / container["nested"]
            if not nested.exists():
                raise UnsupportedInstall(f"레시피가 말한 안쪽 파일이 없음: {container['nested']}")
            extract_nestedly(nested, staged, nested.name, keep_xar)
    else:
        extract_nestedly(download_path, staged, basename, keep_xar)
    # cask의 rename (예: "Android Studio*.app" -> "Android Studio Preview Canary.app")
    for op in recipe.get("rename") or []:
        matches = sorted(staged.glob(op["from"]))
        if matches:
            matches[0].rename(staged / op["to"])


def attach_dmg(dmg_path: Path, label: str) -> Path:
    mount_point = Path(tempfile.gettempdir()) / f"jige-{label}"
    subprocess.run(["hdiutil", "detach", str(mount_point)], capture_output=True)
    mount_point.mkdir(parents=True, exist_ok=True)
    # 라이선스 동의창(EULA)이 붙은 DMG는 표준입력으로 동의를 기다림 — brew처럼 'Y'로 넘김
    result = subprocess.run(
        ["hdiutil", "attach", "-nobrowse", "-readonly", "-noautoopen", "-quiet",
         "-mountpoint", str(mount_point), str(dmg_path)],
        capture_output=True, text=True, input="Y\n",
    )
    if result.returncode != 0:
        sys.exit(
            f"디스크 이미지를 열 수 없음: {dmg_path.name}\n"
            f"  hdiutil: {(result.stderr or result.stdout).strip() or f'종료 코드 {result.returncode}'}"
        )
    return mount_point


def detach_dmg(mount_point: Path) -> None:
    if subprocess.run(["hdiutil", "detach", str(mount_point)], capture_output=True).returncode != 0:
        # 앱이 파일을 잡고 있어서 안 풀리는 경우가 있음 — brew도 강제로 다시 시도
        subprocess.run(["hdiutil", "detach", "-force", str(mount_point)], capture_output=True)
    try:
        mount_point.rmdir()
    except OSError:
        pass


