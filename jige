def _download_json(url: str, dest: Path) -> None:
    print(f"(처음 검색이거나 캐시가 24시간 지남 — {dest.name} 새로 받는 중...)", file=sys.stderr)
    tmp = dest.with_suffix(dest.suffix + ".part")
    urllib.request.urlretrieve(url, tmp)
    tmp.rename(dest)


def load_homebrew_index(kind: str) -> list[dict]:
    """kind: 'cask' 또는 'formula'. 전체 목록을 로컬에 캐시해서 재사용."""
    INDEX_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    dest = INDEX_CACHE_DIR / f"{kind}.json"
    if not dest.exists() or (time.time() - dest.stat().st_mtime) > INDEX_MAX_AGE_SECONDS:
        try:
            _download_json(HOMEBREW_BULK_API.format(kind=kind), dest)
        except Exception as e:  # 네트워크 문제 등 — 캐시가 있으면 그거라도 쓴다
            if not dest.exists():
                print(f"Homebrew {kind} 인덱스를 못 받았음: {e}", file=sys.stderr)
                return []
    return json.loads(dest.read_text())


def _display_width(s: str) -> int:
    """터미널에서 실제로 차지하는 칸 수. 한글/이모지처럼 두 칸 쓰는 문자가 있어서
    len()만으로 패딩하면(파이썬은 글자 수만 셈) 한글이 섞인 칸이 실제보다 좁게
    계산돼 테이블이 밀림 — search 결과에 한글 헤더(종류/분류/버전)·태그(🆕 등)가
    섞이면서 실제로 겪은 문제. "A"(폭 모호, "…"·"★"·"▼" 등)도 2칸으로 침 — 한글
    로케일 터미널에서는 이런 문자를 넓게 그리는 경우가 많아서("…" 때문에 줄바꿈이
    생겼던 적 있음), 좀 넉넉하게 잡는 쪽이 줄바꿈/정렬 깨짐보다 안전함."""
    width = 0
    for ch in s:
        width += 2 if unicodedata.east_asian_width(ch) in ("W", "F", "A") else 1
    return width


def _pad(s: str, width: int) -> str:
    return s + " " * max(0, width - _display_width(s))


def _supports_color() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _supports_unicode() -> bool:
    """출력 인코딩이 UTF-8 계열이 아니면(옛 터미널, 특정 locale 등) 이모지/기호
    대신 ASCII로 대체 — 깨진 문자(□, ?)로 나오는 것보단 밋밋해도 읽히는 게 나음."""
    enc = (getattr(sys.stdout, "encoding", None) or "").lower()
    return "utf" in enc


def _sym(unicode_form: str, ascii_form: str) -> str:
    return unicode_form if _supports_unicode() else ascii_form


def _bold(s: str) -> str:
    """항상 _pad()/_truncate_to_width()로 먼저 폭을 맞춘 뒤에 감싸야 함 — ANSI
    코드 자체는 화면에 안 보이지만 글자 수로는 잡혀서, 먼저 감싸면 폭 계산이 틀어짐."""
    return f"\033[1m{s}\033[0m" if _supports_color() else s


def _truncate_to_width(s: str, max_width: int) -> str:
    if _display_width(s) <= max_width:
        return s
    ellipsis = _sym("…", "...")
    ellipsis_w = _display_width(ellipsis)
    out: list[str] = []
    w = 0
    for ch in s:
        cw = 2 if unicodedata.east_asian_width(ch) in ("W", "F", "A") else 1  # _display_width와 맞춤
        if w + cw > max_width - ellipsis_w:
            break
        out.append(ch)
        w += cw
    return "".join(out) + ellipsis


def simplify_version_for_display(version: str) -> str:
    """search 결과 화면에만 쓰는 버전 표시 — 빌드번호/리비전 suffix(",175245"나
    "-174740" 같은 것)는 보기엔 필요 없어서 뺌. 설치에 쓰는 실제 레시피의 version/
    url/sha256은 이 함수를 안 거치고 fetch_recipe()로 새로 받아오므로 전혀 영향 없음."""
    v = version.split(",")[0]
    v = re.split(r"-(?=\d)", v, maxsplit=1)[0]
    return v


def _rank(query: str, *fields: str) -> int:
    """낮을수록 더 관련 있음. 매칭 안 되면 None 대신 큰 값을 돌려주는 쪽에서 걸러냄."""
    q = query.lower()
    for i, field in enumerate((f.lower() for f in fields if f)):
        if field == q:
            return i * 10 + 0
        if field.startswith(q):
            return i * 10 + 1
        if q in field:
            return i * 10 + 2
    return 999


def search_homebrew(query: str) -> list[dict]:
    hits = []
    for kind, source in (("cask", "homebrew-cask"), ("formula", "homebrew-formula")):
        for entry in load_homebrew_index(kind):
            if kind == "cask":
                token = entry.get("token", "")
                display_name = entry.get("name")
                display_name = display_name[0] if isinstance(display_name, list) else (display_name or token)
                version = entry.get("version", "?")
            else:  # formula: name은 그냥 문자열이고 그 자체가 설치 식별자
                token = entry.get("name", "")
                display_name = token
                version = (entry.get("versions") or {}).get("stable", "?")
            desc = entry.get("desc", "")
            rank = _rank(query, token, display_name, desc)
            if rank < 999:
                # 대체판 상세(최신판 버전/EOL 여부/근거)는 더 이상 search 테이블에 안 욱여넣고
                # jige info에서 보게 함 — search는 ▼ 기호만 띄움(cmd_search가 처리).
                legacy = pick_legacy_for_this_mac(token) if kind == "cask" else None
                if legacy:
                    version = legacy["version"]
                hits.append({
                    "name": token,
                    "version": version,
                    "desc": desc,
                    "source": source,
                    "kind": "jim" if kind == "cask" else "dogu",  # jim(짐)=데스크톱 앱, dogu(도구)=CLI
                    "rank": rank,
                    "legacy": legacy,
                })
    return hits


def search_macports(query: str) -> list[dict]:
    if current_os() != "macos":
        return []
    try:
        with urllib.request.urlopen(
            f"{MACPORTS_SEARCH_API}?search={urllib.parse.quote(query)}", timeout=10
        ) as r:
            data = json.load(r)
    except Exception as e:
        print(f"MacPorts 검색 실패(무시하고 계속): {e}", file=sys.stderr)
        return []
    hits = []
    for entry in data.get("results", [])[:30]:
        name = entry.get("name", "")
        desc = entry.get("description", "")
        rank = _rank(query, name, desc)
        hits.append({
            "name": name,
            "version": entry.get("version", "?"),
            "desc": desc,
            "source": "macports",
            "kind": "unknown",  # TODO: 포트파일 상세조회(app_dir 등)로 jim/dogu 구분 보강
            "rank": rank,
        })
    return hits


def search_mas(query: str, allow_mas: bool) -> list[dict]:
    # 옛 Homebrew-Cask가 별도 tap이었던 것처럼, mas는 설치돼 있어도 기본은 꺼짐.
    # 'jige config mas on'으로 켜거나 그때그때 --mas를 줘야 참여함.
    if not allow_mas or current_os() != "macos" or not shutil.which("mas"):
        return []
    try:
        params = urllib.parse.urlencode(
            {"media": "software", "entity": "macSoftware", "country": "kr", "term": query, "limit": 15}
        )
        with urllib.request.urlopen(f"{ITUNES_SEARCH_API}?{params}", timeout=10) as r:
            data = json.load(r)
    except Exception as e:
        print(f"Mac App Store 검색 실패(무시하고 계속): {e}", file=sys.stderr)
        return []
    hits = []
    for entry in data.get("results", []):
        name = entry.get("trackName", "")
        rank = _rank(query, name)
        hits.append({
            "name": name,
            "version": entry.get("version", "?"),
            "desc": entry.get("sellerName", ""),
            "source": "mas",
            "kind": "jim",  # mas는 전부 GUI 앱
            "rank": rank,
        })
    return hits


def search_local_recipes(query: str) -> list[dict]:
    hits = []
    if not LOCAL_RECIPES_DIR.exists():
        return hits
    for path in LOCAL_RECIPES_DIR.glob("*.json"):
        try:
            entry = json.loads(path.read_text())
        except json.JSONDecodeError:
            continue
        name = entry.get("name", path.stem)
        name = name[0] if isinstance(name, list) else name
        desc = entry.get("desc", "")
        rank = _rank(query, path.stem, name, desc)
        if rank < 999:
            hits.append({
                "name": path.stem,
                "version": entry.get("version", "?"),
                "desc": desc,
                "source": "local",
                "kind": entry.get("kind", "unknown"),  # 레시피에 직접 적어두면 됨: "jim"(데스크톱 앱) | "dogu"(CLI)
                "rank": rank,
            })
    return hits


def cmd_search(query: str, limit_per_source: int = 8, mas: bool = False) -> None:
    allow_mas = mas_enabled() or mas
    all_hits = (
        search_local_recipes(query) + search_macports(query)
        + search_mas(query, allow_mas) + search_homebrew(query)
    )
    if not all_hits:
        print(t("no_results", q=query))
        if not allow_mas:
            print("(Mac App Store는 안 뒤짐 — 포함하려면 'jige search ... --mas' 또는 'jige config mas on')")
        return

    by_source: dict[str, list[dict]] = {}
    for h in all_hits:
        by_source.setdefault(h["source"], []).append(h)

    rows = []
    for source, hits in by_source.items():
        hits.sort(key=lambda h: h["rank"])
        rows.extend(hits[:limit_per_source])
    rows.sort(key=lambda h: h["rank"])

    installed = load_state()

    # 종류는 jim/dogu 텍스트 대신 아이콘, 분류는 Homebrew/MacPorts 대신 실제 명령어 이름
    # (brew/port/mas) — 둘 다 짧아지는 김에 칸도 실제 값 기준으로 동적 계산.
    # ★(이미 설치됨)/▼+신뢰도(이 macOS용 대체판 — 상세는 jige info)는 버전 칸 "안"이 아니라
    # 분류와 버전 사이 별도의 좁은 칸에 둠 — 버전 문자열 안에 넣으면 마커 있는 행만 버전이
    # 오른쪽으로 밀려서 다른 행들과 버전 시작 위치가 안 맞았음(피드백으로 발견).
    # desc엔 더 이상 아무것도 안 욱여넣음 — 폭 제약 없는 맨 끝 칸이라도 너무 길어지면
    # 읽기 힘들다는 피드백이 있었어서, 마커만 보고 필요하면 jige info로 넘어가게 함.
    icons = [kind_icon(h["kind"]) for h in rows]
    sources = [SOURCE_LABEL.get(h["source"], h["source"]) for h in rows]
    version_fields = [simplify_version_for_display(h["version"]) for h in rows]
    markers = []
    any_star = False
    any_legacy = False
    for h in rows:
        marker = ""
        if h["name"] in installed:
            marker += _sym("★", "*")
            any_star = True
        legacy = h.get("legacy")
        if legacy:
            marker += _sym("▼", "v") + trust_badge(legacy)
            any_legacy = True
        markers.append(marker)
    show_marker_col = any_star or any_legacy

    name_w = max(4, min(28, max(_display_width(h["name"]) for h in rows)))
    kind_w = max(_display_width(t("col_kind")), max(_display_width(i) for i in icons))
    source_w = max(_display_width(t("col_source")), max(_display_width(s) for s in sources))
    marker_w = max((_display_width(m) for m in markers), default=0) if show_marker_col else 0
    version_w = max(_display_width(t("col_version")), max(_display_width(v) for v in version_fields))

    # desc 칸은 터미널 실제 가로폭에 맞춰서 자름 — 고정폭으로 하면 좁은 터미널에서 줄이
    # 꺾여서 다음 줄의 칸 정렬까지 같이 깨짐. 끝에서 2칸은 여유로 남겨둠(안전 마진).
    marker_col_w = (marker_w + 2) if show_marker_col else 0
    prefix_w = name_w + 2 + kind_w + 2 + source_w + 2 + marker_col_w + version_w + 2
    term_width = shutil.get_terminal_size(fallback=(100, 24)).columns
    desc_budget = max(20, term_width - prefix_w - 2)

    marker_header = _pad("", marker_w) + "  " if show_marker_col else ""
    print(
        f"{_pad(t('col_name'), name_w)}  {_pad(t('col_kind'), kind_w)}  "
        f"{_pad(t('col_source'), source_w)}  {marker_header}{_pad(t('col_version'), version_w)}  {t('col_desc')}"
    )
    print("-" * min(term_width, prefix_w + 20))
    for h, icon, source, marker, version_field in zip(rows, icons, sources, markers, version_fields):
        name_field = _pad(h["name"], name_w)
        if h["name"] in installed:
            name_field = _bold(name_field)  # _pad()로 폭을 먼저 맞춘 뒤에 감싸야 함
        desc = _truncate_to_width(h["desc"] or "", desc_budget)
        marker_field = _pad(marker, marker_w) + "  " if show_marker_col else ""
        print(
            f"{name_field}  {_pad(icon, kind_w)}  {_pad(source, source_w)}  "
            f"{marker_field}{_pad(version_field, version_w)}  {desc}"
        )

    print()
    print(t("install_hint"))
    legend = []
    if any_star:
        legend.append(f"{_sym('★', '*')} 이미 설치됨")
    if any_legacy:
        legend.append(f"{_sym('▼', 'v')} 이 macOS에 맞춘 대체판 — 자세히: jige info <이름>")
    if legend:
        print("  " + " / ".join(legend))


def fetch_mas_recipe(token: str, allow_mas: bool) -> dict | None:
    """App Store 앱 이름으로 정확히 일치하는 걸 찾아서 (mas install이 쓸 숫자 id 포함) 반환.
    mas가 꺼져있거나 설치 안 돼 있으면 조회 자체를 건너뜀."""
    if not allow_mas or current_os() != "macos" or not shutil.which("mas"):
        return None
    try:
        params = urllib.parse.urlencode(
            {"media": "software", "entity": "macSoftware", "country": "kr", "term": token, "limit": 25}
        )
        with urllib.request.urlopen(f"{ITUNES_SEARCH_API}?{params}", timeout=10) as r:
            data = json.load(r)
    except Exception:
        return None
    for entry in data.get("results", []):
        if entry.get("trackName", "").lower() == token.lower():
            return {
                "name": [entry["trackName"]],
                "version": entry.get("version", "?"),
                "homepage": entry.get("trackViewUrl"),
                "desc": entry.get("sellerName", ""),
                "_mas_id": entry["trackId"],
                "_min_macos": entry.get("minimumOsVersion"),
            }
    return None


def fetch_recipe(token: str, allow_mas: bool = False) -> tuple[dict, str]:
    """(레시피, 출처설명) 반환. 로컬 recipes/ -> Homebrew-Cask -> Mac App Store 순으로 찾음."""
    local_path = LOCAL_RECIPES_DIR / f"{token}.json"
    if local_path.exists():
        return json.loads(local_path.read_text()), f"로컬 레시피 ({local_path})"

    url = HOMEBREW_CASK_API.format(token=urllib.parse.quote(token, safe=""))
    try:
        with urllib.request.urlopen(url, timeout=15) as r:
            return json.load(r), "Homebrew-Cask 공개 레시피"
    except urllib.error.HTTPError as e:
        if e.code != 404:
            raise

    mas_recipe = fetch_mas_recipe(token, allow_mas)
    if mas_recipe:
        return mas_recipe, "Mac App Store"

    hint = (
        "recipes/{0}.json 을 같은 스키마로 직접 추가하면 설치할 수 있습니다."
        if allow_mas or mas_enabled() else
        "Mac App Store는 안 뒤져봤습니다 — 'jige install {0} --mas' 또는 'jige config mas on'으로 켜보세요."
    ).format(token)
    sys.exit(f"'{token}'는 Homebrew-Cask·로컬 recipes/ 어디에도 없습니다.\n-> {hint}")


def pick_url_sha(recipe: dict, cpu: str, codename: str) -> tuple[str, str]:
    if cpu == "arm64":
        return recipe["url"], recipe["sha256"]
    variations = recipe.get("variations") or {}
    v = variations.get(codename)
    if v:
        return v["url"], v["sha256"]
    return recipe["url"], recipe["sha256"]  # Intel 전용 override가 없으면 기본값


def sha256_of(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def download(url: str, dest: Path) -> None:
    if dest.exists():
        print(f"캐시 사용: {dest.name}")
        return
    print(f"다운로드: {url}")
    tmp = dest.with_suffix(dest.suffix + ".part")
    urllib.request.urlretrieve(url, tmp)
    tmp.rename(dest)


def attach_dmg(dmg_path: Path, label: str) -> Path:
    mount_point = Path("/Volumes") / f"jige-{label}"
    subprocess.run(["hdiutil", "detach", str(mount_point)], capture_output=True)
    subprocess.run(
        ["hdiutil", "attach", "-nobrowse", "-quiet",
         "-mountpoint", str(mount_point), str(dmg_path)],
        check=True,
    )
    return mount_point


def detach_dmg(mount_point: Path) -> None:
    subprocess.run(["hdiutil", "detach", str(mount_point)], capture_output=True)


def install_dmg(dmg_path: Path, app_name: str) -> Path:
    mount_point = attach_dmg(dmg_path, app_name)
    try:
        src = mount_point / app_name
        if not src.exists():
            candidates = list(mount_point.glob("*.app"))
            if not candidates:
                sys.exit(f"DMG 안에서 {app_name} 을 못 찾음: {list(mount_point.iterdir())}")
            src = candidates[0]
        dest = Path("/Applications") / src.name
        if dest.exists():
            print(f"기존 {dest} 교체 (새 버전으로 덮어씀)")
            shutil.rmtree(dest)
        print(f"{src} -> {dest}")
        shutil.copytree(src, dest, symlinks=True)
    finally:
        detach_dmg(mount_point)
    return dest


def install_pkg(mount_point: Path, pkg_artifact: list) -> None:
    """cask의 {"pkg": ["X.pkg", {"choices": [...]}]} 아티팩트를 그대로 설치.
    .app을 /Applications에 복사하는 게 아니라 pre/postflight 스크립트가 있는
    설치 패키지라서 installer(sudo 필요)를 그대로 호출한다."""
    pkg_filename = pkg_artifact[0]
    pkg_path = mount_point / pkg_filename
    if not pkg_path.exists():
        sys.exit(f"DMG 안에서 {pkg_filename} 을 못 찾음: {list(mount_point.iterdir())}")

    choices = next(
        (extra["choices"] for extra in pkg_artifact[1:]
         if isinstance(extra, dict) and "choices" in extra),
        None,
    )
    choices_plist: Path | None = None
    cmd = ["sudo", "installer", "-pkg", str(pkg_path), "-target", "/"]
    if choices:
        fd, tmp_name = tempfile.mkstemp(suffix=".plist")
        os.close(fd)
        choices_plist = Path(tmp_name)
        with open(choices_plist, "wb") as f:
            plistlib.dump(choices, f)
        cmd += ["-applyChoiceChangesXML", str(choices_plist)]

    print("관리자 권한(sudo)이 필요합니다 — 비밀번호를 입력하세요.")
    try:
        subprocess.run(cmd, check=True)
    finally:
        if choices_plist:
            choices_plist.unlink(missing_ok=True)


def installed_version(app_path: Path) -> str | None:
    plist_path = app_path / "Contents" / "Info.plist"
    if not plist_path.exists():
        return None
    with open(plist_path, "rb") as f:
        return plistlib.load(f).get("CFBundleShortVersionString")


def load_state() -> dict:
    if not STATE_FILE.exists():
        return {}
    try:
        return json.loads(STATE_FILE.read_text())
    except json.JSONDecodeError:
        return {}


def save_state(state: dict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, ensure_ascii=False, indent=2))


def load_config() -> dict:
    if not CONFIG_FILE.exists():
        return {}
    try:
        return json.loads(CONFIG_FILE.read_text())
    except json.JSONDecodeError:
        return {}


def save_config(config: dict) -> None:
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(config, ensure_ascii=False, indent=2))


def mas_enabled() -> bool:
    """mas는 설치돼 있어도 기본은 꺼짐 — 옛 Homebrew-Cask가 별도 tap이었던 것과 같은 자세.
    'jige config mas on'으로 명시적으로 켜야 search/install에 참여함."""
    return load_config().get("mas_enabled", False)


def cmd_config(key: str | None, value: str | None) -> None:
    config = load_config()
    if key is None:
        print(f"mas_enabled = {config.get('mas_enabled', False)} (mas 검색/설치 참여 여부, 기본 False)")
        return

    if key == "mas":
        if value not in ("on", "off"):
            sys.exit("사용법: jige config mas on|off")
        config["mas_enabled"] = (value == "on")
        save_config(config)
        print(f"mas_enabled = {config['mas_enabled']}")
        if config["mas_enabled"] and not shutil.which("mas"):
            print("(참고: mas CLI가 아직 설치 안 돼 있음 — 설치 전까진 검색에도 안 끼어듦)")
        return

    sys.exit(f"알 수 없는 설정: {key} (지금은 'mas'만 있음)")


def install_via_mas(token: str, recipe: dict) -> None:
    """mas install <id>를 그대로 호출. 실제 다운로드·인증은 로그인된 App Store 세션이 처리."""
    mas_id = recipe["_mas_id"]
    check_macos_requirement(recipe.get("_min_macos"), token)
    if not shutil.which("mas"):
        sys.exit(
            "mas CLI가 없어서 Mac App Store 앱은 설치 못 함.\n"
            "-> https://github.com/mas-cli/mas/releases 에서 이 macOS와 맞는 버전을 받으세요\n"
            "   (최신판이 너무 새 Xcode를 요구해 구버전 macOS에선 설치가 안 될 수 있음 — 이 프로젝트에서 iMac이 그랬음)."
        )
    print(f"mas install {mas_id} 실행 중...")
    subprocess.run(["mas", "install", str(mas_id)], check=True)

    state = load_state()
    state[token] = {
        "mas_id": mas_id,
        "version": recipe.get("version"),
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    save_state(state)
    print(f"완료: {token} (Mac App Store, id {mas_id}, 버전 {recipe.get('version')})")


def resolve_version_for_this_mac(
    token: str, recipe: dict, force_latest: bool
) -> tuple[dict, dict | None]:
    """recipes/legacy/<token>.json에 이 머신이 쓸 수 있는 대체판이 있고 최신판은
    이 macOS를 지원 안 하는 걸로 큐레이션돼 있으면, 안내하고 물어본 뒤 recipe를
    그 대체판으로 바꿔서 반환. (recipe, 실제로 쓴 legacy entry 또는 None)을 반환."""
    legacy = pick_legacy_for_this_mac(token)
    if not legacy or force_latest:
        return recipe, None

    latest_version = recipe.get("version")
    current = ".".join(str(p) for p in macos_version_tuple())
    eol_note = " (참고: Oracle 기준 더 이상 지원 안 하는 EOL 버전)" if legacy.get("vendor_status") == "eol" else ""
    print()
    print(f"참고: 이 Mac은 macOS {sw_vers_codename()}({current})입니다.")
    print()
    print(f"  최신판   {latest_version:<10} macOS {legacy['latest_min_macos']} 이상 필요 → 이 Mac에서 설치 안 될 가능성 높음")
    print(f"  대체판   {legacy['version']:<10} macOS {legacy['min_macos']}~{legacy['max_macos']} 지원, 이 Mac에서 동작 확인됨{eol_note}")
    print(f"           신뢰도: {trust_label(legacy)}")
    print()

    choice = ""
    if sys.stdin.isatty():
        choice = input("어느 걸 설치할까요? [1] 대체판(추천)  [2] 최신판(강행)  번호 [1]: ").strip()
    else:
        print("(비대화형 실행이라 묻지 않고 대체판을 고릅니다 — 최신판을 강행하려면 --latest)")

    if choice == "2":
        return recipe, None

    merged = dict(recipe)
    merged["version"] = legacy["version"]
    merged["url"] = legacy["url"]
    merged["sha256"] = legacy["sha256"]
    merged["variations"] = legacy.get("variations", {})
    # 최신판의 depends_on.macos는 대체판엔 안 맞음 — macos_in_range()로 이미
    # 이 머신이 대체판 범위에 맞는 걸 확인했으니 여기서 지워서 이중 체크 안 함
    # (안 지우면 대체판으로 바꿔놓고도 최신판 기준 macOS 요구치로 다시 막혀버림)
    merged["depends_on"] = {}
    if legacy.get("app"):
        # 구버전은 .app 번들 이름 자체가 다를 수 있음 (예: Audacity.app -> 최신판 Audacity 4.app)
        merged["artifacts"] = [
            {**a, "app": [legacy["app"]]} if "app" in a else a
            for a in merged.get("artifacts", [])
        ]
    return merged, legacy


def cmd_install(token: str, mas: bool = False, latest: bool = False) -> None:
    codename = sw_vers_codename()
    cpu = arch()
    print(f"macOS 코드네임: {codename} / 아키텍처: {cpu}")

    recipe, source = fetch_recipe(token, allow_mas=mas_enabled() or mas)
    print(f"레시피: {recipe.get('name')} ({source}, 등록 버전 {recipe.get('version')})")

    if "_mas_id" in recipe:
        install_via_mas(token, recipe)
        return

    latest_version = recipe.get("version")  # 대체판으로 바뀌기 전 버전 — list에 "최신은 X" 표시용
    recipe, legacy_used = resolve_version_for_this_mac(token, recipe, force_latest=latest)

    macos_min = (recipe.get("depends_on") or {}).get("macos", {}).get(">=")
    if macos_min:
        check_macos_requirement(macos_min[0], token)

    url, sha = pick_url_sha(recipe, cpu, codename)
    print(f"선택된 다운로드: {url}")

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    filename = re.sub(r"[^A-Za-z0-9._-]", "_", url.rsplit("/", 1)[-1])
    dmg_path = CACHE_DIR / f"{token}-{recipe.get('version')}-{filename}"
    download(url, dmg_path)

    actual_sha = sha256_of(dmg_path)
    if actual_sha != sha:
        dmg_path.unlink()
        sys.exit(f"sha256 불일치! 기대값={sha} 실제값={actual_sha} — 다운로드 파일 삭제, 설치 중단.")
    print("sha256 체크섬 일치 확인됨.")

    app_artifact = next(
        (a["app"][0] for a in recipe.get("artifacts", []) if "app" in a), None
    )
    pkg_artifact = next(
        (a["pkg"] for a in recipe.get("artifacts", []) if "pkg" in a), None
    )

    if app_artifact:
        before = installed_version(Path("/Applications") / app_artifact)
        installed_path = install_dmg(dmg_path, app_artifact)
        after = installed_version(installed_path)
        app_label = installed_path.name  # 레거시판은 .app 번들 이름이 다를 수 있어 실제 설치된 이름을 씀
    elif pkg_artifact:
        before = None  # .pkg는 설치 전/후 버전을 안정적으로 추적하기 어려워 범위 밖
        mount_point = attach_dmg(dmg_path, token)
        try:
            install_pkg(mount_point, pkg_artifact)
        finally:
            detach_dmg(mount_point)
        after = recipe.get("version")
        name = recipe.get("name")
        app_label = name[0] if isinstance(name, list) else (name or token)
    else:
        print("레시피에 .app/.pkg 아티팩트가 없음 (아직 미지원 설치 방식)")
        offer_github_contribution(
            f"{token}: .app/.pkg 둘 다 아닌 설치 방식",
            f"토큰: {token}\nmacOS: {codename} ({'.'.join(str(p) for p in macos_version_tuple())})\n"
            f"아키텍처: {cpu}\n레시피 버전: {recipe.get('version')}\n"
            f"공식 홈페이지: {recipe.get('homepage', '?')}\n",
        )
        sys.exit(1)

    state = load_state()
    state[token] = {
        "app": app_label,
        "version": after,
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    if legacy_used:
        # macOS 호환 때문에 일부러 구버전으로 깐 것 — list에서도 이 사실이 남아있어야
        # "지금 구버전만 보임, 최신판이 있다는 걸 몰랐음" 같은 상황이 안 생김.
        # macOS를 업그레이드하면 'jige upgrade'가 이 머신을 다시 확인해서 자동으로
        # 최신판으로 바꿔줌(resolve_version_for_this_mac이 그때는 legacy를 안 고름).
        state[token]["legacy"] = True
        state[token]["latest_version"] = latest_version
        state[token]["latest_min_macos"] = legacy_used["latest_min_macos"]
    save_state(state)

    print()
    print(f"완료: {app_label}  {before or '(미설치)'} -> {after}")

    if legacy_used:
        confirmation = {
            "date": datetime.date.today().isoformat(),
            "macos": ".".join(str(p) for p in macos_version_tuple()),
            "arch": cpu,
            "note": "실제 설치 성공",
        }
        print(f"이 대체판({legacy_used['version']})이 이 Mac({codename})에서 설치됐습니다.")
        print(f"현재 신뢰도: {trust_label(legacy_used)} — 확인 기록 하나 추가해주시면 도움이 됩니다.")
        offer_github_contribution(
            f"confirm: {token} {legacy_used['version']} on macOS {codename}",
            f"recipes/legacy/{token}.json의 confirmations 배열에 아래 한 줄 추가해주세요:\n\n"
            f"{json.dumps(confirmation, ensure_ascii=False, indent=2)}\n",
            fallback_edit_path=f"recipes/legacy/{token}.json",
        )


