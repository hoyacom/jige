        print(f"{i:<8}{r['name']:<16}{r['url']:<40}  {auth}")


def _guess_file_platform_arch(filename: str) -> tuple[str | None, str | None]:
    """파일명에서 플랫폼/아키텍처를 최선 노력으로 추측 — scan이 자동으로 채워주되,
    확신 없으면 None으로 둬서 '전부 지원' 기본값이 적용되게 함. 틀릴 수 있으니
    생성된 jige-catalog.json을 확인/수정하는 걸 권장."""
    low = filename.lower()
    platform = None
    if any(s in low for s in (".dmg", ".pkg", "mac", "darwin", "osx")):
        platform = "macos"
    elif any(s in low for s in (".exe", ".msi", "win")):
        platform = "windows"
    elif any(s in low for s in (".deb", ".rpm", ".appimage", "linux")):
        platform = "linux"

    file_arch = None
    if any(s in low for s in ("arm64", "aarch64")):
        file_arch = "arm64"
    elif any(s in low for s in ("x86_64", "amd64", "x64")):
        file_arch = "x86_64"

    return platform, file_arch


def cmd_user_repo_scan(repo_path: str, token: str, app_name: str | None, kind: str) -> None:
    """<repo_path>/<버전 폴더>/ 안의 파일들을 훑어서 jige-catalog.json에 등록. 폴더명이
    버전이고, 그 안의 파일 하나하나가 이 레포지토리가 내보내는 아티팩트라고 가정 — 파일
    명으로 platform/arch를 추측해서 채워두지만(최선 노력, 틀릴 수 있음) 못 알아내면
    생략해서 jige는 그걸 '전부 지원'으로 취급함. 로컬 경로에만 씀(원격 쓰기는 미지원)."""
    base = Path(repo_path).expanduser()
    if not base.is_dir():
        sys.exit(f"디렉터리 없음: {base}")
    catalog_path = base / USER_REPO_CATALOG_NAME
    catalog = json.loads(catalog_path.read_text()) if catalog_path.exists() else {}
    entry = catalog.setdefault(token, {
        "kind": kind, "desc": "", "artifacts": [{"app": [app_name or f"{token}.app"]}],
    })
    versions: dict = entry.setdefault("versions", {})

    for version_dir in sorted(p for p in base.iterdir() if p.is_dir()):
        version = version_dir.name
        files = []
        for f in sorted(version_dir.iterdir()):
            if not f.is_file():
                continue
            platform, file_arch = _guess_file_platform_arch(f.name)
            file_info = {"path": f"{version}/{f.name}", "sha256": sha256_of(f)}
            if platform:
                file_info["platform"] = platform
            if file_arch:
                file_info["arch"] = file_arch
            files.append(file_info)
        if files:
            versions[version] = {"files": files}

    catalog_path.write_text(json.dumps(catalog, ensure_ascii=False, indent=2))
    print(f"{catalog_path} 갱신 — '{token}' 버전 {len(versions)}개 등록")
    print("(platform/arch는 파일명으로 추측한 것 — 틀렸으면 catalog.json을 직접 고치세요)")


def cmd_user_repo_add_file(
    repo_path: str, file_path: str, token: str, version: str,
    platform: str | None, file_arch: str | None, min_os: str | None,
) -> None:
    """파일 하나를 로컬 레포지토리로 복사하고 jige-catalog.json에 등록. 로컬 경로에만 씀."""
    base = Path(repo_path).expanduser()
    src = Path(file_path).expanduser()
    if not src.is_file():
        sys.exit(f"파일 없음: {src}")
    dest_rel = f"{version}/{src.name}"
    dest = base / dest_rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(src, dest)

    catalog_path = base / USER_REPO_CATALOG_NAME
    catalog = json.loads(catalog_path.read_text()) if catalog_path.exists() else {}
    entry = catalog.setdefault(token, {"kind": "unknown", "desc": "", "artifacts": []})
    files = entry.setdefault("versions", {}).setdefault(version, {"files": []})["files"]
    file_info = {"path": dest_rel, "sha256": sha256_of(dest)}
    if platform:
        file_info["platform"] = platform
    if file_arch:
        file_info["arch"] = file_arch
    if min_os:
        file_info["min_os"] = min_os
    files.append(file_info)

    catalog_path.write_text(json.dumps(catalog, ensure_ascii=False, indent=2))
    print(f"{catalog_path}에 등록: '{token}' v{version} -> {dest_rel}")
    if entry["artifacts"] == []:
        print(f"(artifacts가 비어있음 — {catalog_path}를 열어서 \"artifacts\": [{{\"app\": [\"...\"]}}] 처럼 직접 채워야 설치됨)")


def install_via_mas(token: str, recipe: dict) -> None:
    """mas install <id>를 그대로 호출. 실제 다운로드·인증은 로그인된 App Store 세션이 처리."""
    mas_id = recipe["_mas_id"]
    check_macos_requirement(recipe.get("_min_macos"), token)
    if not shutil.which("mas"):
        sys.exit(
            "mas CLI가 없어서 Mac App Store 앱은 설치 못 함.\n"
            "-> https://github.com/mas-cli/mas/releases 에서 이 macOS와 맞는 버전을 받으세요\n"
            "   (최신판이 너무 새 Xcode를 요구해 구버전 macOS에선 설치가 안 될 수 있음 — 이 프로젝트에서 iMac이 그랬음)."
        )
    print(f"mas install {mas_id} 실행 중...")
    subprocess.run(["mas", "install", str(mas_id)], check=True)

    state = load_state()
    state[token] = {
        "mas_id": mas_id,
        "version": recipe.get("version"),
        "source": "mas",
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    save_state(state)
    print(f"완료: {token} (Mac App Store, id {mas_id}, 버전 {recipe.get('version')})")


HOMEBREW_INSTALL_SCRIPT_URL = (
    "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh"
)


def ensure_brew_installed() -> None:
    """brew가 없으면 brew.sh 공식 설치 스크립트를 그대로 돌릴지 물어봄.
    bottle 재배치를 jige가 직접 구현하는 대신 진짜 brew를 쓰기로 한 이상, brew 자체도
    jige가 새로 만들지 않고 Homebrew의 공식 설치기를 그대로 호출 — install.sh가 Xcode
    Command Line Tools 없을 때 GUI 설치기로 유도하는 것과 같은 '기존 설치기에 위임' 패턴.
    비대화형(파이프/스크립트)에서는 silently sudo 설치기를 돌리지 않고 안내만 하고 멈춤."""
    if shutil.which("brew"):
        return
    print("이 머신엔 Homebrew(brew)가 없습니다 — CLI 도구(dogu) 설치엔 brew가 필요합니다.")
    if not sys.stdin.isatty():
        sys.exit(
            "-> https://brew.sh 의 설치 스크립트를 먼저 실행한 뒤 다시 시도하세요\n"
            "   (비대화형 실행이라 jige가 직접 묻지 않고 여기서 멈춥니다)."
        )
    answer = input(
        "지금 brew.sh 공식 설치 스크립트로 Homebrew를 설치할까요? "
        "(관리자 비밀번호 필요) [y/N] "
    ).strip().lower()
    if answer != "y":
        sys.exit("-> https://brew.sh 에서 나중에 직접 설치할 수 있습니다.")

    print("brew.sh 공식 설치 스크립트를 실행합니다...")
    try:
        subprocess.run(
            ["/bin/bash", "-c", f'$(curl -fsSL {HOMEBREW_INSTALL_SCRIPT_URL})'],
            check=True,
        )
    except subprocess.CalledProcessError as e:
        sys.exit(f"Homebrew 설치 실패 (종료 코드 {e.returncode}) — https://brew.sh 안내를 참고해 직접 설치해주세요.")

    if not shutil.which("brew"):
        # 방금 설치됐어도 이 프로세스의 PATH엔 아직 없을 수 있음(셸 rc 재적용 전) —
        # Apple Silicon/Intel 표준 설치 경로를 직접 찾아서 이번 실행에서만 PATH에 추가.
        for candidate in (Path("/opt/homebrew/bin/brew"), Path("/usr/local/bin/brew")):
            if candidate.exists():
                os.environ["PATH"] = f"{candidate.parent}:{os.environ.get('PATH', '')}"
                break
    if not shutil.which("brew"):
        sys.exit("Homebrew는 설치된 것 같지만 이번 실행에서 못 찾았습니다 — 터미널을 새로 열고 다시 시도해주세요.")


def install_via_brew_formula(token: str, entry: dict) -> None:
    """brew install <formula>를 그대로 호출. Homebrew formula(bottle)는 바이너리에
    /opt/homebrew(또는 /usr/local) 경로가 하드코딩돼 있어서 Homebrew 디렉터리 구조 없이
    jige가 직접 재배치해 설치하면 깨짐 — 그래서 재구현하지 않고 이미 설치된(또는 방금 설치한)
    진짜 brew에 설치/의존성 해결을 그대로 위임함(mas install을 그대로 부르는 것과 같은 방식)."""
    name = entry.get("name", token)
    ensure_brew_installed()
    print(f"brew install {name} 실행 중...")
    try:
        subprocess.run(["brew", "install", name], check=True)
    except subprocess.CalledProcessError as e:
        sys.exit(f"{token}: brew install 실패 (종료 코드 {e.returncode})")

    state = load_state()
    state[token] = {
        "name": name,
        "version": (entry.get("versions") or {}).get("stable"),
        "source": "brew-formula",
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    save_state(state)
    print(f"완료: {token} (brew formula)")


def ensure_port_installed() -> None:
    """port가 없으면 MacPorts 공식 GitHub Release의 .pkg를 받아서 설치할지 물어봄.
    brew.sh 같은 단일 curl 스크립트가 없는 대신(macOS 버전별 .pkg 배포) — jige가 이미
    cask .pkg 설치에 쓰는 run_pkg_installer()를 그대로 재사용할 수 있어서, 공식 설치기에
    위임하는 대신 jige 스스로 받아서 체크섬 검증 후 설치함(ensure_brew_installed와 같은
    확인 패턴: 비대화형에선 묻지 않고 안내만 하고 멈춤)."""
    if shutil.which("port"):
        return
    print("이 머신엔 MacPorts(port)가 없습니다 — MacPorts 항목 설치엔 port가 필요합니다.")
    if not sys.stdin.isatty():
        sys.exit(
            "-> https://www.macports.org/install.php 에서 먼저 설치한 뒤 다시 시도하세요\n"
            "   (비대화형 실행이라 jige가 직접 묻지 않고 여기서 멈춥니다)."
        )
    answer = input(
        "지금 MacPorts 공식 .pkg(GitHub Releases)를 받아서 설치할까요? "
        "(관리자 비밀번호 필요) [y/N] "
    ).strip().lower()
    if answer != "y":
        sys.exit("-> https://www.macports.org/install.php 에서 나중에 직접 설치할 수 있습니다.")

    ver = subprocess.check_output(["sw_vers", "-productVersion"], text=True).strip()
    major = ver.split(".")[0]
    os_token = MACPORTS_PKG_OS_TOKEN.get("10.15" if major == "10" else major)
    if not os_token:
        sys.exit(
            f"이 macOS 메이저버전({major})용 MacPorts .pkg 파일명을 jige가 아직 모름.\n"
            "-> https://www.macports.org/install.php 에서 직접 설치하세요."
        )

    with urllib.request.urlopen(MACPORTS_RELEASES_API, timeout=15) as r:
        release = json.load(r)
    assets = {a["name"]: a["browser_download_url"] for a in release.get("assets", [])}
    pkg_name = next((n for n in assets if n.endswith(f"-{os_token}.pkg")), None)
    chk_name = next((n for n in assets if n.endswith(".chk.txt")), None)
    if not pkg_name or not chk_name:
        sys.exit(
            f"MacPorts 최신 릴리스({release.get('tag_name', '?')})에서 이 macOS용 .pkg나 체크섬 파일을 못 찾음.\n"
            "-> https://www.macports.org/install.php 에서 직접 설치하세요."
        )

    with urllib.request.urlopen(assets[chk_name], timeout=15) as r:
        chk_text = r.read().decode()
    # .pkg는 sha256이 없고 sha1만 제공됨(소스 tar만 sha256 있음) — 그래도 공식 릴리스가
    # 직접 publish한 값이라 AI 요약/추정이 아닌, jige의 기존 체크섬 원칙과 같은 선상.
    m = re.search(rf"^SHA1\({re.escape(pkg_name)}\)=\s*([0-9a-f]{{40}})", chk_text, re.M)
    if not m:
        sys.exit(f"{pkg_name}의 체크섬을 {chk_name}에서 못 찾음 — https://www.macports.org/install.php 에서 직접 설치하세요.")
    expected_sha1 = m.group(1)

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    pkg_path = CACHE_DIR / pkg_name
    download(assets[pkg_name], pkg_path)
    actual_sha1 = sha1_of(pkg_path)
    if actual_sha1 != expected_sha1:
        pkg_path.unlink()
        sys.exit(f"sha1 불일치! 기대값={expected_sha1} 실제값={actual_sha1} — 다운로드 파일 삭제, 설치 중단.")
    print("체크섬 일치 확인됨.")
    run_pkg_installer(pkg_path, [pkg_name])

    if not shutil.which("port"):
        # 설치 직후 이 프로세스 PATH엔 아직 없을 수 있음 — MacPorts 표준 경로를 직접 추가.
        for candidate in (Path("/opt/local/bin"), Path("/opt/local/sbin")):
            if candidate.exists():
                os.environ["PATH"] = f"{candidate}:{os.environ.get('PATH', '')}"
    if not shutil.which("port"):
        sys.exit("MacPorts는 설치된 것 같지만 이번 실행에서 못 찾았습니다 — 터미널을 새로 열고 다시 시도해주세요.")


def install_via_port(token: str, entry: dict) -> None:
    """sudo port install <port>를 그대로 호출. MacPorts도 brew와 같은 이유(자체 디렉터리
    구조에 맞물린 바이너리)로 jige가 직접 재구현해 설치하지 않고, 이미 설치돼 있거나
    (ensure_port_installed가) 방금 설치한 진짜 port에 install만 위임함."""
    name = entry.get("name", token)
    ensure_port_installed()
    print(f"sudo port install {name} 실행 중...")
    try:
        subprocess.run(["sudo", "port", "install", name], check=True)
    except subprocess.CalledProcessError as e:
        sys.exit(f"{token}: port install 실패 (종료 코드 {e.returncode})")

    state = load_state()
    state[token] = {
        "name": name,
        "version": entry.get("version"),
        "source": "macports",
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    save_state(state)
    print(f"완료: {token} (MacPorts)")


def resolve_version_for_this_mac(
    token: str, recipe: dict, cpu: str, force_latest: bool, force_find_legacy: bool = False
) -> tuple[dict, dict | None]:
    """최신판이 이 macOS에서 안 될 수 있으면 대체판을 찾아서(저장소/로컬 발견 캐시 우선,
    없으면 필요할 때만 Homebrew git 기록을 즉석 검색) 안내하고 물어본 뒤 recipe를 바꿔서
    반환. (recipe, 실제로 쓴 legacy entry 또는 None)을 반환."""
    if force_latest:
        return recipe, None

    target_major = macos_version_tuple()[0]
    legacy = pick_legacy_for_this_mac(token)

    if not legacy:
        # 저장소/로컬에 없음 — depends_on이 이미 이 macOS를 막는다고 확실히 말하거나
        # 사용자가 --find-legacy로 명시 요청했을 때만 즉석 검색(비용이 커서 조건부로만 함)
        macos_min = (recipe.get("depends_on") or {}).get("macos", {}).get(">=")
        blocked = bool(macos_min) and not meets_min_macos(macos_min[0])
        if not (blocked or force_find_legacy):
            return recipe, None
        print(f"\n이 Mac(macOS {target_major})에서 쓸 수 있는 과거 버전을 Homebrew 기록에서 찾는 중...")
        found = find_legacy_commit_live(token, target_major, cpu)
        if not found:
            print("(못 찾음 — 최신판으로 진행합니다)")
            return recipe, None
        save_discovery(token, str(target_major), found)
        legacy = found
        print(f"찾음: {found['commit_url']} (근거: {found['found_by']})")

    legacy_recipe = fetch_recipe_from_cask_rb(legacy["commit_url"], cpu)
    latest_version = recipe.get("version")
    current = ".".join(str(p) for p in macos_version_tuple())
    print()
    print(f"참고: 이 Mac은 macOS {sw_vers_codename()}({current})입니다.")
    print()
    print(f"  최신판   {latest_version}")
    print(f"  대체판   {legacy_recipe['version']}  (근거: {legacy['found_by']}, 신뢰도: {trust_label(legacy)})")
    print()

    choice = ""
    if sys.stdin.isatty():
        choice = input("어느 걸 설치할까요? [1] 대체판(추천)  [2] 최신판(강행)  번호 [1]: ").strip()
    else:
        print("(비대화형 실행이라 묻지 않고 대체판을 고릅니다 — 최신판을 강행하려면 --latest)")

    if choice == "2":
        return recipe, None
    return legacy_recipe, legacy


def _install_from_user_repo(token: str, chosen: dict) -> None:
    """사용자 레포지토리에서 받아서 설치. 공식 경로(fetch_recipe -> pick_url_sha -> download)
    대신 repo_fetch_file로 받지만, 그 뒤(포장 풀기 -> 아티팩트 설치)는 똑같은 파이프라인을
    그대로 씀 — stage_download/install_artifacts는 recipe의 artifacts/version만 보고
    url/sha256을 직접 참조하지 않아서 그대로 재사용 가능함."""
    repo = chosen["repo"]
    entry = chosen["entry"]
    version = chosen["version"]
    file_info = chosen["file"]
    name = entry.get("name", token)
    print(f"레시피: {name} (사용자 레포 '{repo['name']}', 등록 버전 {version})")

    recipe = {"version": version, "artifacts": entry.get("artifacts", [])}
    todo, skipped = plan_artifacts(recipe)
    if not todo:
        sys.exit(f"{token}: jige가 아직 지원하지 않는 설치 방식입니다 — {', '.join(skipped) or '설치 항목 없음'}")

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    relpath = file_info["path"]
    filename = re.sub(r"[^A-Za-z0-9._-]", "_", Path(relpath).name)
    download_path = CACHE_DIR / f"{token}-{version}-{filename}"
    print(f"가져오는 중: 사용자 레포 '{repo['name']}' / {relpath}")
    repo_fetch_file(repo, relpath, download_path)

    actual_sha = sha256_of(download_path)
    expected_sha = file_info.get("sha256")
    if expected_sha and actual_sha != expected_sha:
        download_path.unlink()
        sys.exit(f"sha256 불일치! 기대값={expected_sha} 실제값={actual_sha} — 받은 파일 삭제, 설치 중단.")
    print("sha256 체크섬 일치 확인됨." if expected_sha else f"(카탈로그에 체크섬이 없어서 대조는 못 함 — 받은 파일의 sha256: {actual_sha})")

    first_app_target = next((_expand_cask_path(a.get("target") or f"/Applications/{Path(v[0]).name}",
                                                token, version, Path("/"))
                             for k, v, a in todo if k == "app"), None)
    before = installed_version(first_app_target) if first_app_target else None

    try:
        with tempfile.TemporaryDirectory(prefix=f"jige-{token}-") as tmp:
            staged = Path(tmp) / "staged"
            stage_download(download_path, relpath, recipe, staged)
            result = install_artifacts(token, recipe, staged)
    except UnsupportedInstall as e:
        sys.exit(f"{token}: 설치 못 함 — {e}")
    except subprocess.CalledProcessError as e:
        sys.exit(f"{token}: 압축 풀기/복사 중 실패 — {' '.join(map(str, e.cmd))[:200]} (종료 코드 {e.returncode})")

    if result["apps"]:
        installed_path = Path(result["apps"][0])
        after = installed_version(installed_path) or version
        app_label = installed_path.name
    else:
        after = version
        app_label = name[0] if isinstance(name, list) else name

    state = load_state()
    state[token] = {
        "app": app_label,
        "version": after,
        "source": f"user_repo:{repo['name']}",
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    if result["apps"]:
        state[token]["apps"] = result["apps"]
    if result["pkg"]:
        state[token]["pkg"] = True
    save_state(state)

    print()
    print(f"완료: {app_label}  {before or '(미설치)'} -> {after}")


def cmd_install(
    token: str, mas: bool = False, latest: bool = False, find_legacy: bool = False,
    repo: str | None = None,
) -> None:
    codename = sw_vers_codename()
    cpu = arch()
    print(f"macOS 코드네임: {codename} / 아키텍처: {cpu}")

    cask_rb_match = CASK_RB_RAW_URL_RE.match(token)
    chosen = {} if cask_rb_match else disambiguate_source(token, repo=repo)
    if chosen.get("kind") == "formula":
        install_via_brew_formula(token, chosen["entry"])
        return
    if chosen.get("kind") == "port":
        install_via_port(token, chosen["entry"])
        return

    legacy_used = None
    if cask_rb_match:
        # brew install --cask <raw url>와 똑같은 발상 — Homebrew-Cask의 특정 커밋(과거
        # 버전 포함)의 .rb를 직접 읽어서 설치. recipes/legacy/ 미리 큐레이션 없이, 사용자가
        # 이미 "이 커밋이 필요하다"고 고른 뒤라 resolve_version_for_this_mac은 건너뜀.
        real_token = cask_rb_match.group(2).rsplit("/", 1)[-1].removesuffix(".rb")
        recipe = fetch_recipe_from_cask_rb(token, cpu)
        source = f"Homebrew-Cask 커밋 {cask_rb_match.group(1)[:10]} (brew 방식 직접 설치)"
        print(f"레시피: {recipe.get('name')} ({source}, 등록 버전 {recipe.get('version')})")
        token = real_token
    elif chosen.get("kind", "").startswith("user_repo:"):
        _install_from_user_repo(token, chosen)
        return
    else:
        recipe, source = fetch_recipe(token, allow_mas=mas_enabled() or mas)
        print(f"레시피: {recipe.get('name')} ({source}, 등록 버전 {recipe.get('version')})")

        if "_mas_id" in recipe:
            install_via_mas(token, recipe)
            return

        latest_version = recipe.get("version")  # 대체판으로 바뀌기 전 버전 — list에 "최신은 X" 표시용
        recipe, legacy_used = resolve_version_for_this_mac(
            token, recipe, cpu, force_latest=latest, force_find_legacy=find_legacy
        )

    macos_min = (recipe.get("depends_on") or {}).get("macos", {}).get(">=")
    if macos_min:
        check_macos_requirement(macos_min[0], token)

    todo, skipped = plan_artifacts(recipe)
    if not todo:
        # 받기 전에 먼저 확인 — 어차피 못 까는 걸 수십 MB 받지 않게
        sys.exit(f"{token}: jige가 아직 지원하지 않는 설치 방식입니다 — {', '.join(skipped) or '설치 항목 없음'}\n"
                 f"(지원: 앱(.app), 앱 폴더(suite), 설치 패키지(.pkg), 설치 프로그램(installer))")

    url, sha = pick_url_sha(recipe, cpu, codename)
    print(f"선택된 다운로드: {url}")

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    filename = re.sub(r"[^A-Za-z0-9._-]", "_", url.rsplit("/", 1)[-1])
    dmg_path = CACHE_DIR / f"{token}-{recipe.get('version')}-{filename}"
    download(url, dmg_path)

    actual_sha = sha256_of(dmg_path)
    if actual_sha != sha:
        dmg_path.unlink()
        sys.exit(f"sha256 불일치! 기대값={sha} 실제값={actual_sha} — 다운로드 파일 삭제, 설치 중단.")
    print("sha256 체크섬 일치 확인됨.")

    # 설치 전 버전 (app 아티팩트가 있으면 그 위치의 Info.plist로)
    first_app_target = next((_expand_cask_path(a.get("target") or f"/Applications/{Path(v[0]).name}",
                                               token, str(recipe.get("version", "")), Path("/"))
                             for k, v, a in todo if k == "app"), None)
    before = installed_version(first_app_target) if first_app_target else None

    # ① 포장 풀기 -> ② 아티팩트 설치 (Homebrew와 같은 두 단계)
    try:
        with tempfile.TemporaryDirectory(prefix=f"jige-{token}-") as tmp:
            staged = Path(tmp) / "staged"
            stage_download(dmg_path, url, recipe, staged)
            result = install_artifacts(token, recipe, staged)
    except UnsupportedInstall as e:
        sys.exit(f"{token}: 설치 못 함 — {e}")
    except subprocess.CalledProcessError as e:
        sys.exit(f"{token}: 압축 풀기/복사 중 실패 — {' '.join(map(str, e.cmd))[:200]} (종료 코드 {e.returncode})")

    if result["apps"]:
        installed_path = Path(result["apps"][0])
        after = installed_version(installed_path) or recipe.get("version")
        app_label = installed_path.name  # 레거시판은 .app 번들 이름이 다를 수 있어 실제 설치된 이름을 씀
    else:
        after = recipe.get("version")
        name = recipe.get("name")
        app_label = name[0] if isinstance(name, list) else (name or token)

    state = load_state()
    state[token] = {
        "app": app_label,
        "version": after,
        "source": source,
        "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    if result["apps"]:
        state[token]["apps"] = result["apps"]  # uninstall이 정확히 이 경로들을 지움
    if result["pkg"]:
        # .pkg로 깐 건 앱 하나 지우는 걸로 안 끝남 — uninstall이 레시피의
        # uninstall 단계(pkgutil 등)를 돌려야 한다는 표시
        state[token]["pkg"] = True
    if result["manual"]:
        print(f"(설치 프로그램을 끝까지 진행해 주세요: {result['manual']})")
    if legacy_used:
