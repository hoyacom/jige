    """mas는 설치돼 있어도 기본은 꺼짐 — 옛 Homebrew-Cask가 별도 tap이었던 것과 같은 자세.
    'jige config mas on'으로 명시적으로 켜야 search/install에 참여함."""
    return load_config().get("mas_enabled", False)


def cmd_config(key: str | None, value: str | None) -> None:
    config = load_config()
    if key is None:
        print(f"mas_enabled = {config.get('mas_enabled', False)} (mas 검색/설치 참여 여부, 기본 False)")
        return

    if key == "mas":
        if value not in ("on", "off"):
            sys.exit("사용법: jige config mas on|off")
        config["mas_enabled"] = (value == "on")
        save_config(config)
        print(f"mas_enabled = {config['mas_enabled']}")
        if config["mas_enabled"] and not shutil.which("mas"):
            print("(참고: mas CLI가 아직 설치 안 돼 있음 — 설치 전까진 검색에도 안 끼어듦)")
        return

    sys.exit(f"알 수 없는 설정: {key} (지금은 'mas'만 있음)")


def cmd_user_repo_add(name: str, url: str, bearer_env: str | None) -> None:
    repos = load_user_repos()
    if any(r["name"] == name for r in repos):
        sys.exit(f"이미 등록된 이름: {name} (지우려면 'jige user-repo remove {name}')")
    _parse_repo_url(url)  # 스킴 검증만 먼저 해둠 — 등록 시점에 바로 알려주려고
    repos.append({"name": name, "url": url, "bearer_env": bearer_env})
    save_user_repos(repos)

    config = load_config()
    order = config.get("user_repo_order", [])
    order.append(name)
    config["user_repo_order"] = order
    save_config(config)
    print(f"등록됨: {name} -> {url}" + (f" (Bearer 토큰: ${bearer_env})" if bearer_env else ""))


def cmd_user_repo_remove(name: str) -> None:
    repos = load_user_repos()
    if not any(r["name"] == name for r in repos):
        sys.exit(f"등록 안 된 이름: {name}")
    save_user_repos([r for r in repos if r["name"] != name])

    config = load_config()
    config["user_repo_order"] = [n for n in config.get("user_repo_order", []) if n != name]
    save_config(config)
    print(f"제거됨: {name}")


def cmd_user_repo_list() -> None:
    repos = load_user_repos()
    if not repos:
        print("등록된 사용자 레포지토리 없음. 'jige user-repo add <이름> <url>'로 등록하세요.")
